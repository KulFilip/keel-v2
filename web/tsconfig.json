{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // the Vite configs import their own .ts files by full name (Vite 8 loads a config that way: configLoader native)
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    // keel Product's pages (../product/web) and the plugins' (../plugins/*/web) import @keel/web-sdk and keel's own
    // packages from here
    "paths": {
      "@keel/web-sdk": ["src/sdk/index.ts"],
      // Vite 8 names its types only in package.json "exports", which a "paths" match does not read
      "vite": ["node_modules/vite/dist/node/index.d.ts"],
      "*": ["node_modules/@types/*", "node_modules/*"]
    }
  },
  "include": ["src", "tools", "vite.config.ts", "plugin.vite.config.ts", "../product/web", "../plugins/*/web"]
}
