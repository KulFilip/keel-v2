#!/bin/sh
# A stand-in for `gh` (copied from api/src/test/kotlin/keel/api/support/ApiTest.kt): no real GitHub. keel2 start is
# given KEEL_GITHUB_LOGIN_GH=<this file>. It logs its arguments to gh.log next to it.
echo "$*" >> "$(dirname "$0")/gh.log"
case "$1 $2" in
  "auth login")
    if [ "$GH_ACCESSIBLE_PROMPTER" != true ]; then sleep 600; fi
    printf 'Authenticate Git with your GitHub credentials? (default: yes) [Y/n] '
    IFS= read -r answer
    if [ "$answer" != Y ]; then echo "did not authenticate git"; exit 1; fi
    echo "! First copy your one-time code: AB12-CD34"
    echo "Press Enter to open https://github.com/login/device in your browser..."
    IFS= read -r enter
    sleep 1;;
  "auth token") echo "gho_fakefakefakefakefakefakefakefake1234";;
  "auth status") echo "github.com"; echo "  ✓ Logged in to github.com account e2e-user (hosts.yml)"; echo "  - Token scopes: 'read:org', 'repo', 'workflow'";;
  "auth logout") echo "Logged out";;
esac
exit 0
