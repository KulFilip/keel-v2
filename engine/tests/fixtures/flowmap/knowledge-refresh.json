{
 "workflow": "knowledge-refresh",
 "name": "knowledge refresh (keel)",
 "steps": [
  {
   "id": "stale_scan",
   "kind": "code",
   "name": "which sections are stale",
   "phase": "memory",
   "action": "knowledge_scan"
  },
  {
   "id": "project_rules",
   "kind": "code",
   "name": "project rules and skills",
   "phase": "memory",
   "action": "project_rules"
  },
  {
   "id": "librarians",
   "kind": "parallel",
   "name": "librarian per section",
   "agent": "librarian",
   "model": "default",
   "phase": "memory",
   "parallel": 5,
   "instructions": "This is a refresh, not a first draft: keep every claim that is still true and its citation. Check first the claims that cite the files below (they changed since the last knowledge check), fix or remove what is no longer true, and add only what the code now makes worth knowing. A section not written yet is written from the code.\n{{data.knowledge_stale.text}}"
  },
  {
   "id": "memory_check",
   "kind": "code",
   "name": "knowledge check",
   "phase": "memory",
   "action": "knowledge_check",
   "lock": true
  },
  {
   "id": "commit",
   "kind": "code",
   "name": "commit",
   "phase": "memory",
   "action": "commit",
   "lock": true
  }
 ],
 "expect": {
  "main": [
   "stale_scan",
   "project_rules",
   "librarians",
   "memory_check",
   "commit"
  ],
  "sections": [
   {
    "kind": "phase",
    "phase": "memory",
    "nodes": [
     {
      "step": "stale_scan",
      "side": []
     },
     {
      "step": "project_rules",
      "side": []
     },
     {
      "step": "librarians",
      "side": []
     },
     {
      "step": "memory_check",
      "side": []
     },
     {
      "step": "commit",
      "side": []
     }
    ]
   }
  ],
  "orphans": [],
  "parent_of": {}
 }
}
