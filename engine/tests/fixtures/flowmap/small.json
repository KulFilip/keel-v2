{
 "workflow": "small",
 "name": "small (keel)",
 "steps": [
  {
   "id": "preflight",
   "kind": "code",
   "name": "preflight + own branch",
   "phase": "preflight",
   "action": "preflight"
  },
  {
   "id": "plan",
   "kind": "agent",
   "name": "a short plan",
   "agent": "explorer",
   "model": "default",
   "phase": "triage",
   "instructions": "Read the request and the code it touches. Write a short plan: 3 to 5 lines on what changes and where, then 1 to 3 acceptance criteria, each one a test can prove, one per line in exactly this form (keel reads only these lines; [API] for a backend test, [WEB] for a frontend one): \"- **AC-1** [API] <what must be true>\". When the request already lists criteria as AC lines, use them with their ids. Ask a question only when the request leaves the result open. When it needs more than 3 criteria, a migration, the API contract or auth, say so: it needs the feature flow."
  },
  {
   "id": "plan_gate",
   "kind": "gate",
   "name": "plan approval",
   "phase": "triage",
   "back": "plan",
   "lock": true
  },
  {
   "id": "red",
   "kind": "agent",
   "name": "red",
   "agent": "test-author",
   "model": "default",
   "phase": "red",
   "per_ac": true
  },
  {
   "id": "verify_red",
   "kind": "code",
   "name": "verify_red",
   "phase": "red",
   "action": "verify_red+commit",
   "per_ac": true,
   "lock": true
  },
  {
   "id": "green",
   "kind": "agent",
   "name": "green",
   "agent": "implementer",
   "model": "default",
   "phase": "green",
   "per_ac": true
  },
  {
   "id": "verify_green",
   "kind": "code",
   "name": "verify_green + commit",
   "phase": "green",
   "action": "verify_green+commit",
   "per_ac": true,
   "lock": true
  },
  {
   "id": "review_fix",
   "kind": "agent",
   "name": "fix the review's findings",
   "agent": "implementer",
   "model": "default",
   "phase": "review-fix",
   "retry_only": true
  },
  {
   "id": "review_fix_commit",
   "kind": "code",
   "name": "verify the suite + commit the fix",
   "phase": "review-fix",
   "action": "verify_green+commit"
  },
  {
   "id": "review",
   "kind": "agent",
   "name": "review the change",
   "agent": "code-reviewer",
   "model": "default",
   "phase": "gate",
   "back": "review_fix",
   "instructions": "Read the plan and its criteria, then the whole branch diff. Check that every criterion has a test that proves it and that the code does only what the plan says. Report only real problems.",
   "rounds": 2
  },
  {
   "id": "diff",
   "kind": "code",
   "name": "the diff for your look",
   "phase": "gate",
   "action": "show_diff"
  },
  {
   "id": "look",
   "kind": "gate",
   "name": "look at the change",
   "phase": "gate",
   "back": "review_fix",
   "lock": true
  },
  {
   "id": "close",
   "kind": "code",
   "name": "done",
   "phase": "close",
   "action": "close_flow",
   "then": "end"
  }
 ],
 "expect": {
  "main": [
   "preflight",
   "plan",
   "plan_gate",
   "red",
   "verify_red",
   "green",
