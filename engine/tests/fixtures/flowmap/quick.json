{
 "workflow": "quick",
 "name": "quick (keel)",
 "steps": [
  {
   "id": "preflight",
   "kind": "code",
   "name": "preflight + own branch",
   "phase": "preflight",
   "action": "preflight"
  },
  {
   "id": "implement",
   "kind": "agent",
   "name": "make the change + a test",
   "agent": "implementer",
   "model": "default",
   "phase": "ac",
   "instructions": "Test first: write the test that proves the requested change (or change the test that covers it) and run it; it must fail, for the reason the change fixes, before you touch the code. Then make the change with the least code, only in the files it needs, and run the tests you touched again. If the change cannot be tested (a text, a doc, a comment), add no test and end with one line \"UNTESTABLE: <why>\". Do not refactor, rename or tidy anything else. When it is bigger than a small change (a new page, a migration, the API contract, several parts), stop and say so: it needs the small or the feature flow."
  },
  {
   "id": "verify",
   "kind": "code",
   "name": "run the tests",
   "phase": "ac",
   "action": "verify_green",
   "back": "implement",
   "lock": true,
   "rounds": 2
  },
  {
   "id": "diff",
   "kind": "code",
   "name": "the diff for your look",
   "phase": "ac",
   "action": "show_diff+test_check"
  },
  {
   "id": "look",
   "kind": "gate",
   "name": "look at the change",
   "phase": "gate",
   "back": "implement",
   "lock": true
  },
  {
   "id": "commit",
   "kind": "code",
   "name": "commit",
   "phase": "ac",
   "action": "commit",
   "lock": true
  },
  {
   "id": "close",
   "kind": "code",
   "name": "done",
   "phase": "close",
   "action": "close_flow",
   "then": "end"
  }
 ],
 "expect": {
  "main": [
   "preflight",
   "implement",
   "verify",
   "diff",
   "look",
   "commit",
   "close"
  ],
