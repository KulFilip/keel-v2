{
 "workflow": "hunt",
 "name": "hunt (keel)",
 "steps": [
  {
   "id": "start",
   "kind": "code",
   "name": "start the hunt",
   "phase": "hunt-scope",
   "action": "hunt_start",
   "lock": true
  },
  {
   "id": "confirm_lenses",
   "kind": "gate",
   "name": "confirm the lenses",
   "phase": "hunt-scope",
   "lock": true,
   "choices": {
    "confirm": "confirm",
    "stop": "end"
   }
  },
  {
   "id": "confirm",
   "kind": "code",
   "name": "lens set",
   "phase": "hunt-scope",
   "action": "hunt_confirm",
   "lock": true
  },
  {
   "id": "map",
   "kind": "agent",
   "name": "map the repository once for every hunter",
   "agent": "explorer",
   "model": "default",
   "phase": "hunt-sweep",
   "when": {
    "data": "hunt.map",
    "equals": "yes"
   },
   "instructions": "Map this repository for the bug hunters that run after you, so none of them reads the tree again: the apps and their entry points (routes, handlers, pages, consumers) with file paths, where the data access and the migrations are, the auth and security code, the tests. Short lines with paths, no prose, at most 80 lines. Change no file. End with the line MAP-END."
  },
  {
   "id": "mapped",
   "kind": "code",
   "name": "the map to every hunter",
   "phase": "hunt-sweep",
   "action": "hunt_map",
   "when": {
    "data": "hunt.map",
    "equals": "yes"
   }
  },
  {
   "id": "deps",
   "kind": "code",
   "name": "dependency audit (security lens)",
   "phase": "hunt-sweep",
   "action": "hunt_deps"
  },
  {
   "id": "sweep",
   "kind": "parallel",
   "name": "one hunter per lens and lane",
   "agent": "hunter",
   "model": "default",
   "phase": "hunt-sweep",
   "from": "sweep_items",
   "markers": [
    "FINDINGS"
   ],
   "collect": "candidates"
  },
  {
   "id": "ingest",
   "kind": "code",
   "name": "ingest candidates",
   "phase": "hunt-sweep",
   "action": "hunt_ingest",
   "lock": true
  },
  {
   "id": "sweep_gate",
   "kind": "gate",
   "name": "candidates (semi)",
   "phase": "hunt-sweep",
   "when": {
    "data": "hunt.mode",
    "equals": "semi"
   },
   "choices": {
    "prove": "stack",
    "stop": "end"
   }
  },
  {
   "id": "stack",
   "kind": "code",
   "name": "the stack is up before the provers",
   "phase": "hunt-prove",
   "action": "hunt_stack"
  },
  {
   "id": "stack_gate",
   "kind": "gate",
   "name": "the stack is down",
   "phase": "hunt-prove",
   "when": {
    "data": "hunt.stack_down"
   },
   "choices": {
    "recheck": "stack",
    "prove": "prove",
    "stop": "end"
   }
  },
  {
   "id": "prove",
   "kind": "parallel",
   "name": "one prover per candidate",
   "agent": "prover",
   "model": "default",
   "phase": "hunt-prove",
   "from": "prove_items",
   "batch": "$data.hunt.prove_concurrency",
   "markers": [
    "PROOF"
   ],
   "collect": "verdicts"
  },
  {
   "id": "verdicts",
   "kind": "code",
   "name": "record verdicts",
   "phase": "hunt-prove",
   "action": "hunt_verdicts",
   "lock": true
  },
  {
   "id": "all_proved",
   "kind": "branch",
   "name": "every candidate has a verdict",
   "phase": "hunt-prove",
   "no": "prove",
   "when": {
    "marker": "LEFT",
    "equals": "none"
   }
  },
  {
   "id": "verdicts_gate",
   "kind": "gate",
   "name": "verdicts (semi)",
   "phase": "hunt-prove",
   "when": {
    "data": "hunt.mode",
    "equals": "semi"
   },
   "choices": {
    "report": "group",
    "stop": "end"
   }
  },
  {
   "id": "group",
   "kind": "parallel",
   "name": "group shared causes",
   "agent": "investigator",
   "model": "default",
   "phase": "hunt-report",
   "from": "group_items",
   "cap": 1,
   "collect": "groups"
  },
  {
   "id": "grouped",
   "kind": "code",
   "name": "record groups",
   "phase": "hunt-report",
   "action": "hunt_group"
  },
  {
   "id": "report",
   "kind": "code",
   "name": "render the report",
   "phase": "hunt-report",
   "action": "hunt_report",
   "lock": true
  },
  {
   "id": "commit",
   "kind": "code",
   "name": "commit the report",
   "phase": "hunt-report",
   "action": "hunt_commit",
   "lock": true
  },
  {
   "id": "close",
   "kind": "code",
   "name": "close a finding",
   "phase": "hunt-triage",
   "action": "hunt_close",
   "back": "triage"
  },
  {
   "id": "triage",
   "kind": "gate",
   "name": "triage",
   "phase": "hunt-triage",
   "choices": {
    "take": "take",
    "close": "close",
    "stop": "end"
   }
  },
  {
   "id": "take",
   "kind": "code",
   "name": "take the top group",
   "phase": "hunt-triage",
   "action": "start_flow",
   "flow": "hunt-next",
   "seed": {
    "title": "Next finding from the hunt",
    "run": "$data.hunt.run",
    "pick": "$data.triage_answer.payload.answers.finding",
    "preview": "no"
   },
   "then": "end"
  }
 ],
 "expect": {
  "main": [
   "start",
   "confirm_lenses",
   "confirm",
   "map",
   "mapped",
   "deps",
   "sweep",
   "ingest",
   "sweep_gate",
   "stack",
   "stack_gate",
   "prove",
   "verdicts",
   "all_proved",
   "verdicts_gate",
   "group",
   "grouped",
   "report",
   "commit",
   "close",
   "triage",
   "take"
  ],
  "sections": [
