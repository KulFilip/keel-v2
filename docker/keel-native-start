#!/usr/bin/env bash
# keel v2 native mode (keel2 start --native): the engine and the api on this computer, no Docker. The same start as
# docker/keel-start, minus what only makes sense in a container: it never writes into $HOME (the agent CLIs get their
# own home under $KEEL_DATA, engine models/cli.py) and it does not look for a Docker socket.
#
#   KEEL_APP   the unpacked release (api.jar, engine/.venv, content/)        set by keel2
#   KEEL_DATA, KEEL_WORKSPACE, KEEL_FOLDERS, KEEL_PORT, KEEL_ENGINE_PORT       set by keel2
set -euo pipefail

: "${KEEL_APP:?KEEL_APP is not set (keel2 start --native sets it)}"
: "${KEEL_DATA:?KEEL_DATA is not set}"
export KEEL_NATIVE=1
export KEEL_CONTENT="${KEEL_CONTENT:-$KEEL_APP/content}"
export KEEL_PORT="${KEEL_PORT:-8080}"
export KEEL_ENGINE_PORT="${KEEL_ENGINE_PORT:-8090}"
export KEEL_ENGINE_URL="http://127.0.0.1:$KEEL_ENGINE_PORT"
export KEEL_API_URL="http://127.0.0.1:$KEEL_PORT"
export KEEL_MCP_PYTHON="$KEEL_APP/engine/.venv/bin/python"
export KEEL_INTERNAL_TOKEN="${KEEL_INTERNAL_TOKEN:-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')}"
export CODEGRAPH_NO_DAEMON=1 CODEGRAPH_TELEMETRY=0 DO_NOT_TRACK=1 CODEGRAPH_NO_UPDATE_CHECK=1
# keel's own agent CLIs and codegraph first (keel2 installs them with npm --prefix), then the person's PATH
if [ -n "${KEEL_NPM:-}" ]; then
  export PATH="$KEEL_NPM/bin:$PATH"
  [ -x "$KEEL_NPM/bin/codegraph" ] && export KEEL_CODEGRAPH_BIN="$KEEL_NPM/bin/codegraph"
fi
mkdir -p "$KEEL_DATA"

echo "keel v2 (native) · data $KEEL_DATA · workspace ${KEEL_WORKSPACE:-} · content $KEEL_CONTENT"

KEEL_ENGINE_HOST=127.0.0.1 "$KEEL_APP/engine/.venv/bin/keel-engine" &
engine=$!

for _ in $(seq 1 120); do
  curl -fs "$KEEL_ENGINE_URL/health" > /dev/null && break
  kill -0 "$engine" 2>/dev/null || { echo "engine failed to start"; exit 1; }
  sleep 0.5
done

java ${JAVA_OPTS:--Xmx1g} -jar "$KEEL_APP/api.jar" &
api=$!

trap 'kill -TERM "$engine" "$api" 2>/dev/null; wait' TERM INT
echo "keel v2 is starting on http://localhost:$KEEL_PORT"
# bash 3.2 (macOS) has no `wait -n`: watch both, stop the other when one ends
while kill -0 "$engine" 2>/dev/null && kill -0 "$api" 2>/dev/null; do sleep 2; done
kill -TERM "$engine" "$api" 2>/dev/null || true
wait || true
exit 1
