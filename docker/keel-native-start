#!/usr/bin/env bash
# keel v2 native mode (keel2 start --native): the engine and the api on this computer, no Docker. The same start as
# docker/keel-start (it runs that file's loop: the plugins resolved at every start, a restart on exit 75, the last good
# plugins when a start fails), minus what only makes sense in a container: it never writes into $HOME (the agent CLIs
# get their own home under $KEEL_DATA, engine models/cli.py) and it does not look for a Docker socket.
#
#   KEEL_APP   the unpacked release (api.jar, engine/.venv, content/, plugins/, keel-start)      set by keel2
#   KEEL_DATA, KEEL_WORKSPACE, KEEL_FOLDERS, KEEL_PORT, KEEL_ENGINE_PORT                         set by keel2
#   KEEL_PLUGINS (on | image | off)                                                              keel2 --safe: image
set -euo pipefail

: "${KEEL_APP:?KEEL_APP is not set (keel2 start --native sets it)}"
: "${KEEL_DATA:?KEEL_DATA is not set}"
export KEEL_NATIVE=1
export KEEL_CONTENT="${KEEL_CONTENT:-$KEEL_APP/content}"
export KEEL_PORT="${KEEL_PORT:-8080}"
# the api has no login: on this computer it must listen on 127.0.0.1 only (Docker publishes 127.0.0.1:<port> instead)
export SERVER_ADDRESS=127.0.0.1
export KEEL_ENGINE_PORT="${KEEL_ENGINE_PORT:-8090}"
export KEEL_ENGINE_URL="http://127.0.0.1:$KEEL_ENGINE_PORT"
export KEEL_API_URL="http://127.0.0.1:$KEEL_PORT"
export KEEL_MCP_PYTHON="$KEEL_APP/engine/.venv/bin/python"
export KEEL_INTERNAL_TOKEN="${KEEL_INTERNAL_TOKEN:-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')}"
export CODEGRAPH_NO_DAEMON=1 CODEGRAPH_TELEMETRY=0 DO_NOT_TRACK=1 CODEGRAPH_NO_UPDATE_CHECK=1
# the plugins that came in the release (as /opt/keel-v2/plugins in the image), with the installed ones in $KEEL_DATA
export KEEL_PLUGINS_IMAGE="${KEEL_PLUGINS_IMAGE:-$KEEL_APP/plugins}"
# keel-start's commands: the release's own engine, api and Python
export KEEL_ENGINE_EXE="$KEEL_APP/engine/.venv/bin/keel-engine"
export KEEL_API_JAR="$KEEL_APP/api.jar"
export KEEL_PYTHON="$KEEL_APP/engine/.venv/bin/python"
export JAVA_OPTS="${JAVA_OPTS:--Xmx1g}"
# keel's own agent CLIs and codegraph first (keel2 installs them with npm --prefix), then the person's PATH
if [ -n "${KEEL_NPM:-}" ]; then
  export PATH="$KEEL_NPM/bin:$PATH"
  [ -x "$KEEL_NPM/bin/codegraph" ] && export KEEL_CODEGRAPH_BIN="$KEEL_NPM/bin/codegraph"
fi
mkdir -p "$KEEL_DATA"

echo "keel v2 (native) · data $KEEL_DATA · workspace ${KEEL_WORKSPACE:-} · content $KEEL_CONTENT"

# keel-start's loop, in this process (keel2 knows a native keel by this script's name in its pid's command line)
# shellcheck source=keel-start
. "$KEEL_APP/keel-start"
