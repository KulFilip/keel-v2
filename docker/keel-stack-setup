#!/usr/bin/env bash
# keel's root helper for a stack's setup.apt (keel 0.18.22, engine/keel_engine/runtime/stack_setup.py).
#
# keel's image has Java, Node and Python. A stack that needs more (PHP, Go, ...) lists the packages in setup.apt; keel's
# engine runs this helper in the background at every start, when a project is added and when a stack changes. keel's
# user may run this one program as root, and only as `keel-stack-setup apt ...` (/etc/sudoers.d/keel-stack-setup).
#
#   keel-stack-setup apt <package>...   install system packages. Each name must be an exact Debian package name;
#                                       anything else is refused before apt runs. The apt cache (package lists and
#                                       downloaded packages) lives in /var/cache/keel-apt, owned by root: keel's user
#                                       cannot write there, so it cannot plant package lists or .debs that root would
#                                       install. The lists are always fetched fresh (apt-get update), so a re-created
#                                       container downloads again.
#
# It does nothing else: no other first argument, no shell commands. A stack's setup.run commands run as keel's own
# user, never through this helper.
set -euo pipefail

CACHE=/var/cache/keel-apt
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8

usage() {
  echo "usage: keel-stack-setup apt <package>..." >&2
  exit 2
}

# a strict Debian package name; also nothing apt could read as a regex or a pattern ("a.+"), and no trailing "-"
# (apt reads "name-" as "remove name")
valid_name() {
  local p=$1
  [ "${#p}" -le 100 ] || return 1
  [[ "$p" =~ ^[a-z0-9][a-z0-9+.-]*[a-z0-9+]$ ]] || return 1
  case "$p" in *.+* | *+.* | *..*) return 1 ;; esac
}

case "${1:-}" in
  apt)
    shift
    [ "$#" -gt 0 ] || usage
    for p in "$@"; do
      valid_name "$p" || { echo "keel-stack-setup: not a package name: $p" >&2; exit 2; }
    done
    # root's own cache, outside the data volume (never a symlink, never keel's)
    if [ -L "$CACHE" ] || { [ -e "$CACHE" ] && [ ! -d "$CACHE" ]; }; then
      echo "keel-stack-setup: refusing $CACHE: not a plain directory" >&2; exit 1
    fi
    install -d -m 755 -o root -g root "$CACHE" "$CACHE/archives" "$CACHE/archives/partial" "$CACHE/lists" "$CACHE/lists/partial"
    opts=(-o "Dir::Cache::Archives=$CACHE/archives" -o "Dir::State::Lists=$CACHE/lists"
          -o APT::Keep-Downloaded-Packages=true -o APT::Sandbox::User=root -o Dpkg::Use-Pty=0)
    echo "keel-stack-setup: updating the package lists"
    apt-get update -q "${opts[@]}"
    # exact names only: apt would also take a glob or a regex as a package name
    names=$(apt-cache "${opts[@]}" pkgnames)
    for p in "$@"; do
      # a here-string, not a pipe: grep -q stops reading at the first match, and under pipefail the writer's SIGPIPE
      # (exit 141) would turn every package that exists into "no such package"
      grep -Fxq -- "$p" <<< "$names" || { echo "keel-stack-setup: no such package: $p" >&2; exit 2; }
    done
    apt-get install -y -q --no-install-recommends "${opts[@]}" -- "$@"
    echo "keel-stack-setup: installed $*"
    ;;
  *) usage ;;
esac
