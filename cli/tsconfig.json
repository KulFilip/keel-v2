{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      // KeelBot's api calls (plugins/keelbot/web/keelbotApi.ts) import keel's transport from @keel/web-sdk: here it is
      // web/src/api.ts itself, re-exported by src/core/sdk.ts
      "@keel/web-sdk": ["src/core/sdk.ts"]
    }
  },
  "include": ["src", "test", "build.mjs"]
}
