<?xml version="1.0" encoding="utf-8"?>
<!-- the device tokens are bound to this phone's keystore: never back them up or move them -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
