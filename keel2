#!/usr/bin/env bash
# keel2 — start and manage keel v2 (one Docker container, or natively with --native) for your project.
#
#   keel2 start [folder]        start keel for a project (default: this folder) and open the browser
#   keel2 start --docker [dir]  same, and let the project's tests use your Docker (Testcontainers, compose)
#   keel2 start --native [dir]  keel on this computer without Docker (Java 21, uv, git; agents run as you).
#                               --from-tarball <file> or --from-source <keel-v2 checkout> instead of the download
#   keel2 start --with-keel-v1 <keel-checkout> [dir]
#                               also offer keel v1's MCP server (optional, off until you turn it on in Tools)
#   keel2 start --safe [dir]    same, in safe mode: only the plugins inside the image load (installed ones wait)
#   keel2 start --core [dir]    same, with keel's core only (the :core image: no plugin inside; add the ones you need
#                               in Control › Plugins). restart and update keep it
#   keel2 stop | restart        stop keel / start it again with the same project and options (they ask first
#                               when agents are working; --force does not ask; restart --safe: in safe mode)
#   keel2 add <folder> [<folder> …]
#                               add more project folders (each a git repo, or a folder of repos); keel restarts once
#   keel2 remove <folder> [<folder> …]
#                               take added folders off the list (keel keeps their projects' history)
#   keel2 folders               the main project folder and the added ones
#   keel2 status                is keel running, for which project, on which port, which edition (core or full)
#   keel2 tui                   keel in the terminal (keel TUI): KeelBot, slash commands, the live flow, agents and the
#                               inbox. Plain `keel2` opens it too, in a terminal while keel runs (KEEL_TUI_DEFAULT=0: help)
#   keel2 open [--print|--dev]  open the dashboard in the browser, signed in (--print: only print the one-time link;
#                               --dev: for the web's dev server on :5173)
#   keel2 auth reset            a new sign-in key: every browser signs in again (keel restarts)
#   keel2 auth key              print the sign-in key, for your own terminal apps (xal's keel plugin); agents never may
#   keel2 logs                  follow keel's log (Ctrl+C to leave)
#   keel2 doctor                check Docker, the port, the image and the project, and say how to fix problems
#   keel2 update                get the newest image and restart keel if it is running (native: the newest
#                               release; keel2 update --rollback goes back one version)
#   keel2 token <claude|codex|copilot|anthropic|openai|github>   save a login or key (encrypted, input hidden);
#                               from the clipboard in one piece: pbpaste | keel2 token claude
#   keel2 tokens                which logins and keys are saved (hints only)
#   keel2 backup [file]         save keel's data (database, logins, history) to a .tgz file
#   keel2 restore <file>        put a backup back (keel is stopped first)
#   keel2 sql                   open keel's SQLite database
#   keel2 mcp [--write|--admin] keel's MCP server on stdio, for Claude Code / Claude Desktop to start: read-only by
#                               default, --write decides gates and starts flows, --admin also stops flows and changes
#                               projects (--allow t1,t2 keeps only those tools). keel2 mcp --print-config shows how
#   keel2 plugins list          the plugins keel has: what loads, what is off, what is left out and why
#   keel2 plugins install <name>[@version]   install a plugin from the marketplace (and the plugins it needs)
#   keel2 plugins remove <name> [--delete-data]   remove an installed plugin (its tables stay)
#   keel2 plugins search [words] | update <name> | rollback <name>
#   keel2 plugins safe          restart keel in safe mode: only the plugins inside the image load
#   keel2 uninstall [--all]     remove the container, or stop a native keel (--all: also keel's data, after you confirm)
#   keel2 version | help
#
# Settings (environment): KEEL_IMAGE, PORT (default 8080; a busy port moves to the next free one), KEEL_NAME,
# KEEL_VOLUME (default keel-data for keel-v2, <KEEL_NAME>-data for any other name), KEEL_OPEN=0 (no browser), KEEL_DOCKER=1 (same as --docker),
# KEEL_PLUGINS=on|image|off (which plugins load: all, only the image's (same as --safe), none). KEEL_IMAGE wins over
# --core.
# Native: KEEL2_HOME (default ~/.keel2), KEEL_YES=1 (yes to the native warning), KEEL_NATIVE_CLIS=0 (no agent CLIs),
# KEEL_RELEASE_URL (where releases are downloaded from).
# Added folders are listed in ${XDG_CONFIG_HOME:-~/.config}/keel2/<KEEL_NAME>.folders (one path per line).
# Logins: dashboard › Control › Connections › "Set up login". They are saved encrypted in keel's database on the
# data volume, so they survive restarts and new images. Nothing from your computer is copied into the container.
set -euo pipefail

KEEL2_VERSION="0.18.16"
IMAGE="${KEEL_IMAGE:-ghcr.io/miladnalbandi/keel-v2:latest}"
# keel's core only (docs/plugins/16-steps5-7-contract.md, step 6): keel2 start --core, unless KEEL_IMAGE is set
CORE_IMAGE="ghcr.io/miladnalbandi/keel-v2:core"
NAME="${KEEL_NAME:-keel-v2}"
# v0.17.2 a keel with its own name gets its own data volume: two keels on one volume write one SQLite database at once
if [ -n "${KEEL_VOLUME:-}" ]; then VOLUME="$KEEL_VOLUME"
elif [ "$NAME" = keel-v2 ]; then VOLUME=keel-data
else VOLUME="$NAME-data"; fi
WANT_PORT="${PORT:-8080}"

# ---------------------------------------------------------------- output
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; D=$'\033[2m'; N=$'\033[0m'
else B=""; G=""; Y=""; R=""; D=""; N=""; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }
info() { printf '%s\n' "$*"; }
die()  { printf '%s✗ %s%s\n' "$R" "$1" "$N" >&2; shift; for l in "$@"; do printf '  %s\n' "$l" >&2; done; exit 1; }
interactive() { [ -t 0 ] && [ -t 1 ]; }
ask_yes() {  # ask_yes "question" → 0 for yes
  interactive || return 1
  local a; read -r -p "  $1 [y/N] " a || return 1
  case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
os() { case "$(uname -s)" in Darwin) echo mac ;; Linux) echo linux ;; MINGW*|MSYS*|CYGWIN*) echo windows ;; *) echo other ;; esac; }

# ---------------------------------------------------------------- docker checks
docker_install_hint() {
  case "$(os)" in
    mac)     echo "Install Docker Desktop: https://docs.docker.com/desktop/setup/install/mac-install/" ;;
    linux)   echo "Install Docker Engine: https://docs.docker.com/engine/install/  (then: sudo usermod -aG docker \$USER, and log in again)" ;;
    windows) echo "Install Docker Desktop and run keel2 inside WSL 2: https://docs.docker.com/desktop/setup/install/windows-install/" ;;
    *)       echo "Install Docker: https://docs.docker.com/get-started/get-docker/" ;;
  esac
}

need_docker() {  # makes sure the docker command exists and the engine answers; starts Docker Desktop on a Mac
  command -v docker >/dev/null 2>&1 || die "Docker is not installed." "$(docker_install_hint)"
  docker info >/dev/null 2>&1 && return 0
  local err; err="$(docker info 2>&1 | tail -3 || true)"
  if printf '%s' "$err" | grep -qi "permission denied"; then
    die "Docker is installed, but this user may not use it." "Run: sudo usermod -aG docker \$USER   then log out and in again."
  fi
  if [ "$(os)" = mac ] && [ -d /Applications/Docker.app ]; then
    info "Docker Desktop is not running. Starting it…"
    open -a Docker || true
    local i; for i in $(seq 1 90); do docker info >/dev/null 2>&1 && { ok "Docker is running"; return 0; }; sleep 2; done
    die "Docker Desktop did not start within 3 minutes." "Open Docker Desktop yourself, wait until it says it is running, then try again."
  fi
  die "The Docker engine is not running." "Start Docker (Docker Desktop, or: sudo systemctl start docker), then try again."
}

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }   # something listens on 127.0.0.1:<port>

container_exists() { docker inspect "$NAME" >/dev/null 2>&1; }

# v0.17.2 the data volume of this keel's container, when it has one (a container from before keel2 named volumes after
# KEEL_NAME keeps the one it has, unless KEEL_VOLUME says otherwise)
resolve_volume() {
  [ -n "${KEEL_VOLUME:-}" ] && return 0
  local was
  was="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}' "$NAME" 2>/dev/null || true)"
  if [ -n "$was" ]; then VOLUME="$was"; fi
}

# The running containers other than this keel's that use its data volume (one name per line).
volume_users() {
  docker ps --filter "volume=$VOLUME" --format '{{.Names}}' 2>/dev/null | grep -vx "$NAME" || true
}

# v0.17.2 refuse a second keel on a data volume another running container uses
volume_guard() {
  local other; other="$(volume_users | head -1)"
  [ -z "$other" ] || die "The data volume $VOLUME is in use by the running container $other." \
    "Two keels must not share one database. Give this keel its own: KEEL_VOLUME=$NAME-data (or stop $other first)."
}
container_running() { [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || echo false)" = true ]; }
label() { docker inspect -f "{{index .Config.Labels \"keel2.$1\"}}" "$NAME" 2>/dev/null || true; }
running_port() { docker port "$NAME" 8080/tcp 2>/dev/null | head -1 | sed 's/.*://'; }

pick_port() {  # the wanted port, or the next free one; our own container's port counts as free (it is replaced)
  local p="$WANT_PORT" mine; mine="$(container_running && running_port || true)"
  local i; for i in $(seq 0 20); do
    if [ "$p" = "$mine" ] || ! port_busy "$p"; then echo "$p"; return 0; fi
    p=$((p + 1))
  done
  die "No free port between $WANT_PORT and $p." "Free one, or choose another: PORT=9090 keel2 start"
}

ensure_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 && return 0
  info "Getting the keel image ($IMAGE). The first time this takes a few minutes…"
  local out
  if ! out="$(docker pull "$IMAGE" 2>&1)"; then
    printf '%s\n' "$out" | tail -3 >&2
    if printf '%s' "$out" | grep -qiE "not found|manifest unknown"; then
      die "There is no image $IMAGE (yet)." "A new release takes about 25 minutes to build: try again later." \
          "Or use the newest published one: KEEL_IMAGE=ghcr.io/miladnalbandi/keel-v2:latest"
    fi
    die "Could not download $IMAGE." "Check your internet connection, then run: keel2 update" \
        "Behind a company proxy? Set it in Docker Desktop › Settings › Resources › Proxies."
  fi
}

api() { echo "http://localhost:${1:-$(running_port)}/api"; }

# v0.18.1 keel's api answers no caller without a credential (api auth/LocalAuth): keel2 sends keel's internal token.
# It never goes on a command line (other users of this computer can read those): curl reads the header from a pipe.
keel_token() {
  if native_mode && ! docker_keel_running; then cat "$ND/run/token" 2>/dev/null || true
  else docker exec "$NAME" cat /data/run/internal-token 2>/dev/null || true; fi
}
kcurl() { curl -H @<(printf 'X-Keel-Token: %s\n' "$(keel_token)") "$@"; }

signin_url() {  # signin_url <api port> [page port] — a one-time sign-in link (60 s) for the dashboard; fails on an old keel
  local body path
  body="$(kcurl -fsS -m 10 -X POST "$(api "$1")/web/code" 2>/dev/null)" || return 1
  path="$(printf '%s' "$body" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')"
  [ -n "$path" ] || return 1
  printf 'http://localhost:%s%s' "${2:-$1}" "$path"
}

open_signed_in() {  # open_signed_in <port> — the dashboard, signed in (an older keel: just the page)
  local u; u="$(signin_url "$1")" || u="http://localhost:$1"
  open_url "$u"
}

# Agents working right now (a restart or stop would throw their work away and the step starts again).
busy_agents() {
  container_running || { echo 0; return; }
  # grep finds nothing when no agent works: that is not an error (set -e / pipefail would end the script silently)
  { kcurl -fs -m 5 "$(api)/jobs?status=running&limit=50" 2>/dev/null || true; } | { grep -o '"agent":"[^"]*"' || true; } | wc -l | tr -d ' '
}

guard_busy() {  # guard_busy "restart" — asks (or refuses) when agents are working; KEEL_FORCE=1 / --force skips it
  [ "${KEEL_FORCE:-0}" = 1 ] && return 0
  local n; n="$(busy_agents)"
  [ "${n:-0}" -gt 0 ] 2>/dev/null || return 0
  warn "$n agent(s) are working right now. To $1 keel stops them: their step starts again later and its tokens are spent again."
  ask_yes "$1 anyway?" && return 0
  die "Not done; keel keeps working." "Wait until the step finishes (keel2 status, or the dashboard), or use --force."
}

wait_healthy() {  # wait_healthy <port>
  local i; for i in $(seq 1 120); do
    curl -fs "$(api "$1")/health" >/dev/null 2>&1 && return 0
    container_running || break
    sleep 1
  done
  bad "keel did not start. The last lines of its log:"
  docker logs --tail 25 "$NAME" 2>&1 | sed 's/^/    /' || true
  die "Start failed." "Run 'keel2 doctor' to check your setup, or 'keel2 logs' to see the whole log."
}

# ---------------------------------------------------------------- project checks
project_path() {  # resolves a folder to an absolute path, or explains what is wrong
  local p="${1:-.}"
  case "$p" in "~"*) p="$HOME${p#\~}" ;; esac
  [ -e "$p" ] || die "There is no folder at: $p" "Give the folder of your project, for example: keel2 start ~/Projects/my-app"
  [ -d "$p" ] || die "$p is a file, not a folder." "Give the project's folder."
  (cd "$p" && pwd -P)
}

check_git() {  # a git repo, or a folder of git repos; offers git init
  local p="$1"
  [ -d "$p/.git" ] || [ -f "$p/.git" ] && return 0
  ls -d "$p"/*/.git >/dev/null 2>&1 && return 0
  warn "$p is not a git repository. keel works on its own git branch and commits there."
  if command -v git >/dev/null 2>&1 && ask_yes "Make it a git repository now (git init, plus a first commit of what is there)?"; then
    git -C "$p" init -q
    git -C "$p" add -A
    git -C "$p" -c user.name="${GIT_AUTHOR_NAME:-keel2}" -c user.email="${GIT_AUTHOR_EMAIL:-keel2@localhost}" commit -qm "Initial commit" --allow-empty
    ok "git repository created"
    return 0
  fi
  die "keel needs a git repository." "Run: git init \"$p\" && git -C \"$p\" add -A && git -C \"$p\" commit -m 'Initial commit'"
}

check_shared() {  # Docker Desktop only shares some folders with containers by default
  [ "$(os)" = mac ] || return 0
  case "$1" in /Users/*|/Volumes/*|/private/*|/tmp/*|/var/folders/*) return 0 ;; esac
  warn "$1 is outside the folders Docker Desktop shares by default (/Users, /Volumes, /private, /tmp)."
  warn "If keel shows an empty project: Docker Desktop › Settings › Resources › File sharing › add this folder."
}

keel_v1_path() {  # a keel v1 checkout for --with-keel-v1: absolute, and it must have mcp/server.js
  local p; p="$(project_path "$1")"
  [ -f "$p/mcp/server.js" ] || die "$p has no mcp/server.js, so it is not a keel v1 checkout." \
    "Give the folder of a keel v1 clone, for example: keel2 start --with-keel-v1 ~/Projects/keel ."
  echo "$p"
}

docker_socket() {  # the host's Docker socket path, for --docker
  # Docker Desktop (Mac, Windows) serves its socket to containers at /var/run/docker.sock, whatever DOCKER_HOST says.
  [ "$(os)" = linux ] || { echo /var/run/docker.sock; return; }
  local s="${DOCKER_HOST:-}"
  case "$s" in unix://*) echo "${s#unix://}"; return ;; esac
  echo /var/run/docker.sock
}

# ---------------------------------------------------------------- added project folders (keel2 add)
# The list is per keel (KEEL_NAME): one absolute host path per line. keel2 start mounts each folder at the same path.
folders_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/keel2/$NAME.folders"; }
list_folders() { local f; f="$(folders_file)"; [ -f "$f" ] || return 0; grep -v '^[[:space:]]*$' "$f" || true; }
is_repo() { [ -d "$1/.git" ] || [ -f "$1/.git" ]; }
# 0.18.17 a git worktree (or submodule) has a .git FILE ("gitdir: /path/main/.git/worktrees/x"): its repository is
# outside the folder, so in keel's container, which mounts only the folder, every git call failed ("fatal: not a git
# repository"). keel2 start mounts the repository's common git dir too, at the same path, so the gitdir line works.
git_common_dir() {  # git_common_dir <folder> — the absolute common git dir of a folder whose .git is a file, or nothing
  [ -f "$1/.git" ] && command -v git >/dev/null 2>&1 || return 0
  local d; d="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 0
  [ -n "$d" ] || return 0
  case "$d" in /*) ;; *) d="$1/$d" ;; esac
  (cd "$d" 2>/dev/null && pwd) || true
}
git_dirs() {  # git_dirs <folder> — git_common_dir of the folder and of the repos one level down (a folder of repos)
  local r; git_common_dir "$1"
  for r in "$1"/*/; do r="${r%/}"; [ -f "$r/.git" ] && git_common_dir "$r"; done
  return 0
}
json_str() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }   # a string for inside JSON quotes
keel_running() { command -v docker >/dev/null 2>&1 && container_running; }
main_project() {  # the main project folder of keel's container, or nothing (no Docker, or never started)
  command -v docker >/dev/null 2>&1 || return 0
  label project
}
container_folders() {  # the KEEL_FOLDERS the running container got, one per line
  command -v docker >/dev/null 2>&1 || return 0
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NAME" 2>/dev/null | sed -n 's/^KEEL_FOLDERS=//p' | tr ':' '\n' || true
}
abs_path() {  # like project_path, but the folder may be gone (for keel2 remove)
  local p="$1"
  case "$p" in "~"*) p="$HOME${p#\~}" ;; esac
  if [ -d "$p" ]; then (cd "$p" && pwd -P); return; fi
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  while [ "${p%/}" != "$p" ] && [ "$p" != / ]; do p="${p%/}"; done
  echo "$p"
}

register_added() {  # register_added <port> <folder>… — every git repo in the added folders becomes a keel project
  local port="$1"; shift
  [ $# -gt 0 ] || return 0
  local known f r j out; known="$(kcurl -fs -m 10 "$(api "$port")/projects" 2>/dev/null || true)"
  local roots=()
  for f in "$@"; do
    if is_repo "$f"; then roots+=("$f"); continue; fi
    for r in "$f"/*/; do
      r="${r%/}"
      if [ -d "$r" ] && is_repo "$r"; then roots+=("$r"); fi
    done
  done
  for r in ${roots[@]+"${roots[@]}"}; do
    j="$(json_str "$r")"
    if printf '%s' "$known" | grep -qF "\"root\":\"$j\""; then continue; fi
    if out="$(kcurl -fsS -m 30 -X POST "$(api "$port")/projects" -H 'content-type: application/json' \
                --data-binary "{\"root\":\"$j\"}" 2>&1)"; then
      ok "project added: $(basename "$r")  ${D}($r)${N}"
    else
      warn "Could not add $r as a project: $out"
    fi
  done
  info "  ${D}More repos? All projects › Add projects lets you pick them.${N}"
}

# ---------------------------------------------------------------- commands
cmd_start() {
  local docker_mode="${KEEL_DOCKER:-0}" folder="" keel_v1="" plugins="${KEEL_PLUGINS:-}" core=0 native=0 tgz="" src=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --docker) docker_mode=1 ;;
      --no-docker) docker_mode=0 ;;
      --safe) plugins=image ;;
      --core) core=1 ;;
      --with-keel-v1)
        [ $# -ge 2 ] || die "--with-keel-v1 needs the folder of a keel v1 checkout" "For example: keel2 start --with-keel-v1 ~/Projects/keel ."
        keel_v1="$(keel_v1_path "$2")"; shift ;;
      --without-keel-v1) keel_v1="" ;;
      --force) KEEL_FORCE=1 ;;
      --native) native=1 ;;
      --from-tarball) [ $# -ge 2 ] || die "--from-tarball needs a keel-v2-<version>-native.tar.gz"; native=1; tgz="$(cd "$(dirname "$2")" && pwd -P)/$(basename "$2")"; shift ;;
      --from-source) [ $# -ge 2 ] || die "--from-source needs a keel-v2 checkout"; native=1; src="$(cd "$2" && pwd -P)"; shift ;;
      -*) die "Unknown option $1" "See: keel2 help" ;;
      *) folder="$1" ;;
    esac
    shift
  done
  case "$plugins" in ""|on|image|off) ;; *) die "KEEL_PLUGINS must be on, image or off (it is '$plugins')." ;; esac
  # --core: the core image (no plugin inside); KEEL_IMAGE, when set, still wins
  if [ "$core" = 1 ] && [ -z "${KEEL_IMAGE:-}" ]; then IMAGE="$CORE_IMAGE"; fi
  local project; project="$(project_path "${folder:-.}")"
  if [ "$native" = 1 ]; then
    [ "$docker_mode" = 1 ] && info "  ${D}Native mode uses this computer's Docker directly, so --docker is not needed.${N}"
    # the release holds every plugin (as the full image does); --core is the core image's, a Docker one
    [ "$core" = 1 ] && die "--core is for the Docker image (keel's core only)." "Native mode has every plugin: start with --safe for only the release's, or KEEL_PLUGINS=off for none."
    check_git "$project"
    NATIVE_PLUGINS="$plugins"
    if [ "$plugins" = image ]; then warn "Safe mode: only the plugins inside the release load. 'keel2 restart' loads all again."; fi
    native_start "$project" "$tgz" "$src"
    return 0
  fi
  if native_running; then die "keel runs natively for $NAME." "Stop it first (keel2 stop), or use another KEEL_NAME."; fi
  rm -f "$ND/mode"
  need_docker
  check_git "$project"
  check_shared "$project"
  local added=() f
  while IFS= read -r f; do
    [ "$f" = "$project" ] && continue
    case "$f" in "$project"/*) info "  ${D}$f is inside the main project, so keel has it already.${N}"; continue ;; esac
    if [ -d "$f" ]; then added+=("$f")
    else warn "The added folder $f is missing, so keel skips it. Take it off the list: keel2 remove \"$f\""; fi
  done < <(list_folders)
  ensure_image
  resolve_volume
  volume_guard

  if container_exists; then
    guard_busy restart
    local old; old="$(label project)"
    if [ -n "$old" ] && [ "$old" != "$project" ]; then info "keel was running for $old — switching to $project."; fi
    docker rm -f "$NAME" >/dev/null 2>&1 || true
  fi
  local port; port="$(pick_port)"
  [ "$port" = "$WANT_PORT" ] || warn "Port $WANT_PORT is in use, so keel uses port $port."

  local args=(-d --name "$NAME" --restart unless-stopped -p "127.0.0.1:$port:8080" -v "$VOLUME:/data"
              --label "keel2.project=$project" --label "keel2.docker=$docker_mode" --label "keel2.keelv1=$keel_v1"
              --label "keel2.core=$core"
              -e KEEL_PROJECT_NAME="$(basename "$project")")
  # keel v1 is not part of keel v2: a checkout given with --with-keel-v1 is mounted read-only, and only its MCP
  # server is offered (off) in Tools, like any other MCP server.
  if [ -n "$keel_v1" ]; then args+=(-v "$keel_v1:/opt/keel-v1-optional:ro"); fi
  if [ "$docker_mode" = 1 ]; then
    # The host's Docker runs the containers tests start. The project is mounted at the SAME path as on this
    # computer, so bind mounts that tests ask the host Docker for (Testcontainers, compose) point at real folders.
    local sock; sock="$(docker_socket)"
    [ -S "$sock" ] || [ "$(os)" = mac ] || die "No Docker socket at $sock." "Is Docker running? With rootless Docker set DOCKER_HOST=unix:///run/user/\$UID/docker.sock"
    local gid; gid="$(docker run --rm -v "$sock:/var/run/docker.sock" --entrypoint stat "$IMAGE" -c %g /var/run/docker.sock 2>/dev/null || echo 0)"
    args+=(-v "$project:$project" -v "$sock:/var/run/docker.sock" --group-add "$gid"
           --add-host host.docker.internal:host-gateway -e KEEL_WORKSPACE="$project")
    warn "Docker access is on: keel's agents can start containers on this computer (that is as strong as root)."
  else
    args+=(-v "$project:/workspace")
  fi
  # Added folders (keel2 add) are mounted at the same path as on this computer, in both modes. KEEL_FOLDERS tells
  # keel every folder it has, as paths inside the container, the main project first.
  local folders; if [ "$docker_mode" = 1 ]; then folders="$project"; else folders=/workspace; fi
  for f in ${added[@]+"${added[@]}"}; do
    check_shared "$f"
    args+=(-v "$f:$f"); folders="$folders:$f"
  done
  args+=(-e KEEL_FOLDERS="$folders")
  # 0.18.17 worktrees and submodules: their repository's git dir, at the same path, unless a folder mounted at the
  # same path holds it already (in the /workspace mode the main project is not at its own path, so it does not count)
  local same=() gd m inside
  if [ "$docker_mode" = 1 ]; then same+=("$project"); fi
  same+=(${added[@]+"${added[@]}"})
  for f in "$project" ${added[@]+"${added[@]}"}; do
    while IFS= read -r gd; do
      [ -n "$gd" ] || continue
      inside=0
      for m in ${same[@]+"${same[@]}"}; do case "$gd" in "$m"|"$m"/*) inside=1 ;; esac; done
      [ "$inside" = 0 ] || continue
      check_shared "$gd"
      args+=(-v "$gd:$gd"); same+=("$gd")
      info "  ${D}$f is a git worktree or submodule: its repository $gd is mounted too.${N}"
    done < <(git_dirs "$f")
  done
  local v; for v in ANTHROPIC_API_KEY OPENAI_API_KEY GITHUB_TOKEN GH_TOKEN CLAUDE_CODE_OAUTH_TOKEN; do
    if [ -n "${!v:-}" ]; then args+=(-e "$v"); fi
  done
  # Plugins (docker/keel-start): on = the image's and the installed ones; image = safe mode; off = none
  if [ -n "$plugins" ]; then args+=(-e "KEEL_PLUGINS=$plugins" --label "keel2.plugins=$plugins"); fi
  if [ "$plugins" = image ]; then warn "Safe mode: only the plugins inside the image load. 'keel2 restart' loads all again."; fi
  if [ "$core" = 1 ]; then info "  ${D}keel's core only: add the plugins you need in Control › Plugins (or a set: Developer, Review…).${N}"; fi

  info "Starting keel for ${B}$project${N}…"
  [ ${#added[@]} = 0 ] || info "  ${D}and ${#added[@]} added folder(s): ${added[*]}${N}"
  docker run "${args[@]}" "$IMAGE" >/dev/null || die "Docker could not start the container." "Run 'keel2 doctor' to find out why."
  wait_healthy "$port"
  ok "keel is running: ${B}http://localhost:$port${N}"
  register_added "$port" ${added[@]+"${added[@]}"}
  info "  ${D}Next: open Control › Connections › Set up login (Claude, Codex or GitHub Copilot).${N}"
  info "  ${D}Stop: keel2 stop · Status: keel2 status · Problems: keel2 doctor${N}"
  [ "${KEEL_OPEN:-1}" = 1 ] && open_signed_in "$port" || true
}

open_url() {
  if command -v open >/dev/null 2>&1; then open "$1" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 || true
  elif command -v wslview >/dev/null 2>&1; then wslview "$1" >/dev/null 2>&1 || true; fi
}

cmd_stop() {
  need_docker
  container_exists || { info "keel is not running."; return 0; }
  [ "${1:-}" = "--force" ] && KEEL_FORCE=1
  guard_busy stop
  docker rm -f "$NAME" >/dev/null && ok "keel stopped (your data and logins are kept)"
}

cmd_restart() {  # keel2 restart [--safe] [--force]; safe mode lasts until the next start without --safe
  # 0.18.15 a restart (keel2 add, restart, a login change) keeps the image keel runs now: it used the local :latest,
  # which can be an old download, so keel went back to an older version without a word. Only keel2 update
  # (KEEL_TAKE_NEW_IMAGE=1) and an explicit KEEL_IMAGE pick another image.
  if [ -z "${KEEL_IMAGE:-}" ] && [ "${KEEL_TAKE_NEW_IMAGE:-}" != 1 ] && container_exists; then
    local running; running="$(docker inspect -f '{{.Config.Image}}' "$NAME" 2>/dev/null || true)"
    [ -n "$running" ] && IMAGE="$running"
  fi
  local safe=() a
  for a in "$@"; do
    case "$a" in
      --force) KEEL_FORCE=1 ;;
      --safe) safe=(--safe) ;;
      *) die "Unknown option $a" "usage: keel2 restart [--safe] [--force]" ;;
    esac
  done
  need_docker
  container_exists || die "keel has not been started yet." "Start it: keel2 start /path/to/project"
  local p d v1; p="$(label project)"; d="$(label docker)"; v1="$(label keelv1)"
  [ -n "$p" ] || die "This container was started by an older keel2 and does not say which project it has." "Start it again: keel2 start /path/to/project"
  local port; port="$(running_port || true)"
  if [ -n "$port" ] && [ -z "${PORT:-}" ]; then WANT_PORT="$port"; fi
  local extra=(); if [ -n "$v1" ] && [ -f "$v1/mcp/server.js" ]; then extra=(--with-keel-v1 "$v1"); fi
  if [ "$(label core)" = 1 ]; then extra+=(--core); fi
  extra+=(${safe[@]+"${safe[@]}"})
  if [ "$d" = 1 ]; then cmd_start --docker ${extra[@]+"${extra[@]}"} "$p"; else cmd_start --no-docker ${extra[@]+"${extra[@]}"} "$p"; fi
}

cmd_add() {  # keel2 add <folder>… — saves the folders in the list, then restarts keel once
  [ $# -gt 0 ] || die "usage: keel2 add <folder> [<folder> …]" "For example: keel2 add ~/Projects/api ~/Projects/web"
  local main a p new=() list; main="$(main_project)"; list="$(list_folders)"
  for a in "$@"; do
    case "$a" in --force) KEEL_FORCE=1; continue ;; -*) die "Unknown option $a" "See: keel2 help" ;; esac
    p="$(project_path "$a")"
    case "$p" in *:*) die "keel cannot add a folder with ':' in its path: $p" "Rename or move the folder, then add it." ;; esac
    if [ -n "$main" ] && [ "$p" = "$main" ]; then info "  $p is keel's main project already."; continue; fi
    if [ -n "$main" ]; then case "$p" in "$main"/*) info "  $p is inside the main project ($main), so keel has it already."; continue ;; esac; fi
    if printf '%s\n' "$list" ${new[@]+"${new[@]}"} | grep -qxF "$p"; then info "  $p is in the list already."; continue; fi
    check_git "$p"
    check_shared "$p"
    new+=("$p")
  done
  if [ ${#new[@]} = 0 ]; then info "Nothing new to add. See the list: keel2 folders"; return 0; fi
  warn_external_layouts "$main" ${new[@]+"${new[@]}"}
  local file; file="$(folders_file)"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "${new[@]}" >> "$file"
  for p in "${new[@]}"; do ok "added $p"; done
  if keel_running; then
    info "Restarting keel once, so it gets the new folder(s)…"
    cmd_restart
  else
    info "  ${D}keel is not running. The folders are mounted when it starts: keel2 start /path/to/project (or keel2 restart)${N}"
  fi
}

warn_external_layouts() {  # warn_external_layouts <main> <new folder>… — keel v1's external layout: .keel links elsewhere
  local main="$1"; shift
  local seen; seen="$(printf '%s\n' "$main" "$@"; list_folders)"
  local f r t inside x
  for f in "$@"; do
    for r in "$f" "$f"/*/; do
      r="${r%/}"
      [ -L "$r/.keel" ] || continue
      t="$(readlink "$r/.keel")"; case "$t" in /*) ;; *) t="$r/$t" ;; esac
      [ -d "$t" ] && t="$(cd "$t" && pwd -P)"   # a relative link (../shared/keel) compared as a real path
      inside=0
      while IFS= read -r x; do [ -n "$x" ] || continue; case "$t" in "$x"|"$x"/*) inside=1 ;; esac; done <<< "$seen"
      [ "$inside" = 1 ] || warn "$(basename "$r"): this project keeps keel's files in $t; add that folder too: keel2 add $t"
    done
  done
}

cmd_remove() {  # keel2 remove <folder>… — takes folders off the list, then restarts keel once
  [ $# -gt 0 ] || die "usage: keel2 remove <folder> [<folder> …]" "keel2 folders shows the list."
  local file a p gone=() list; file="$(folders_file)"; list="$(list_folders)"
  [ -n "$list" ] || die "No folders were added, so there is nothing to remove." "Add one: keel2 add <folder>"
  for a in "$@"; do
    case "$a" in --force) KEEL_FORCE=1; continue ;; -*) die "Unknown option $a" "See: keel2 help" ;; esac
    p="$(abs_path "$a")"
    if printf '%s\n' "$list" | grep -qxF "$p"; then gone+=("$p"); else warn "$p is not in the list (keel2 folders shows it)."; fi
  done
  if [ ${#gone[@]} = 0 ]; then info "Nothing changed."; return 0; fi
  local keep; keep="$(printf '%s\n' "$list" | grep -vxF -f <(printf '%s\n' "${gone[@]}") || true)"
  if [ -n "$keep" ]; then printf '%s\n' "$keep" > "$file"; else rm -f "$file"; fi
  for p in "${gone[@]}"; do ok "removed $p"; done
  info "  ${D}keel keeps those projects' history. Add the folder again to see it.${N}"
  if keel_running; then
    info "Restarting keel once, so it lets go of the folder(s)…"
    cmd_restart
  fi
}

cmd_folders() {
  local main f n=0 mounted; main="$(main_project)"; mounted="$(container_folders)"
  if [ -n "$main" ]; then
    info "main     $main$([ -d "$main" ] || echo "  ${R}(missing)${N}")"
  else
    info "main     ${D}(not known: keel has not been started. keel2 start /path/to/project)${N}"
  fi
  while IFS= read -r f; do
    n=$((n + 1))
    if [ ! -d "$f" ]; then info "added    $f  ${R}(missing: keel skips it; keel2 remove takes it off)${N}"
    elif [ -n "$mounted" ] && ! printf '%s\n' "$mounted" | grep -qxF "$f"; then info "added    $f  ${Y}(not in keel yet: keel2 restart)${N}"
    else info "added    $f"; fi
  done < <(list_folders)
  [ "$n" -gt 0 ] || info "  ${D}No added folders. Add some: keel2 add <folder> [<folder> …]${N}"
  info "  ${D}list: $(folders_file)${N}"
}

cmd_status() {
  need_docker
  resolve_volume
  if ! container_exists; then info "keel is ${B}not running${N}. Start it: keel2 start /path/to/project"; return 0; fi
  if ! container_running; then info "keel is ${B}stopped${N} (container $NAME exists). Start it again: keel2 restart"; return 0; fi
  local port; port="$(running_port)"
  local health=starting body version=""
  if body="$(curl -fs "$(api "$port")/health" 2>/dev/null)"; then
    health=ready
    version="$(printf '%s' "$body" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
  fi
  info "keel is ${B}running${N} ($health)"
  info "  dashboard  http://localhost:$port"
  [ -n "$version" ] && info "  version    keel v2 $version"
  info "  edition    $(edition_text)"
  info "  project    $(label project)"
  local f; while IFS= read -r f; do
    info "  added      $f$([ -d "$f" ] || echo "  (missing)")"
  done < <(list_folders)
  info "  docker     $([ "$(label docker)" = 1 ] && echo "on (tests may start containers)" || echo off)"
  [ -n "$(label keelv1)" ] && info "  keel v1    MCP server offered from $(label keelv1) (Tools, off until turned on)"
  case "$(label plugins)" in
    image) info "  plugins    safe mode: only the image's (keel2 restart loads all again)" ;;
    off)   info "  plugins    off (KEEL_PLUGINS=off)" ;;
  esac
  info "  image      $(docker inspect -f '{{.Config.Image}}' "$NAME")"
  info "  data       volume $VOLUME"
}

# The edition the running image was built as (its KEEL_EDITION: core, full or product; an image from before the plugins
# has none, and has every part inside).
edition_text() {
  local e; e="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NAME" 2>/dev/null | sed -n 's/^KEEL_EDITION=//p' | head -1)"
  case "$e" in
    core)    echo "core (keel's core only, no plugin inside: add them in Control › Plugins)" ;;
    product) echo "product (every plugin inside, and keel Product, beta)" ;;
    full|dev|"") echo "full (every plugin inside)" ;;
    *)       echo "$e" ;;
  esac
}

cmd_open() {  # keel2 open [--print] [--dev] — v0.18.1 signed in: a one-time link (60 s) that sets this browser's cookie
  local print=0 page="" a
  for a in "$@"; do
    case "$a" in
      --print) print=1 ;;
      --dev) page=5173 ;;
      *) die "Unknown option $a" "usage: keel2 open [--print] [--dev]" ;;
    esac
  done
  need_docker
  container_running || die "keel is not running." "Start it: keel2 start /path/to/project"
  local port u; port="$(running_port)"
  u="$(signin_url "$port" "${page:-$port}")" || u="http://localhost:${page:-$port}"
  if [ "$print" = 1 ]; then
    printf '%s\n' "$u"
    info "${D}The link signs one browser in; it works once, for 60 seconds.${N}" >&2
    return 0
  fi
  info "http://localhost:${page:-$port}"; open_url "$u"
}

cmd_auth() {  # keel2 auth reset — v0.18.1 a new sign-in key (api auth/WebKey): every browser and terminal app signs in again
  case "${1:-}" in
    reset)
      need_docker
      container_running || die "keel is not running." "Start it: keel2 start /path/to/project"
      if native_mode && ! docker_keel_running; then rm -f "$ND/data/run/web-key"
      else docker exec "$NAME" rm -f /data/run/web-key || die "Could not remove the sign-in key."; fi
      ok "The old sign-in key is gone. keel makes a new one when it starts again."
      cmd_restart --force
      info "  ${D}Every browser signs in again: keel2 open${N}" ;;
    key)  # v0.18.1 for the person's own terminal apps on this computer (xal's keel plugin); keel's rule keel-keys
          # refuses it to every agent
      need_docker
      container_running || die "keel is not running." "Start it: keel2 start /path/to/project"
      local k
      if native_mode && ! docker_keel_running; then k="$(cat "$ND/data/run/web-key" 2>/dev/null || true)"
      else k="$(docker exec "$NAME" cat /data/run/web-key 2>/dev/null || true)"; fi
      [ -n "$k" ] || die "This keel has no sign-in key yet (keel 0.18.1 and newer make one)." "Update keel: keel2 update"
      printf '%s\n' "$k" ;;
    *) die "usage: keel2 auth reset | keel2 auth key" "reset makes a new sign-in key: every browser has to sign in again (keel2 open)." ;;
  esac
}

cmd_doctor() {
  local problems=0
  info "${B}keel2 doctor${N}"
  if command -v docker >/dev/null 2>&1; then ok "docker command: $(docker --version 2>/dev/null | sed 's/,.*//')"
  else bad "Docker is not installed. $(docker_install_hint)"; problems=$((problems + 1)); fi
  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then ok "Docker engine is running ($(docker info -f '{{.ServerVersion}}' 2>/dev/null), $(docker info -f '{{.NCPU}}' 2>/dev/null) CPUs, $(( $(docker info -f '{{.MemTotal}}' 2>/dev/null || echo 0) / 1073741824 )) GB memory)"
      local mem; mem="$(docker info -f '{{.MemTotal}}' 2>/dev/null || echo 0)"
      [ "$mem" -ge 3500000000 ] 2>/dev/null || warn "Docker has less than 4 GB memory. Agents and builds are faster with more (Docker Desktop › Settings › Resources)."
      if docker image inspect "$IMAGE" >/dev/null 2>&1; then ok "image: $IMAGE"
      else warn "image $IMAGE is not downloaded yet (keel2 start gets it)"; fi
      if container_running; then ok "keel is running on http://localhost:$(running_port) for $(label project)"
        curl -fs "$(api)/health" >/dev/null 2>&1 && ok "keel answers" || { bad "keel's container runs but does not answer. See: keel2 logs"; problems=$((problems + 1)); }
      elif container_exists; then warn "keel's container exists but is stopped (keel2 restart)"
      else info "  ${D}keel is not running${N}"; fi
      if ! container_running && port_busy "$WANT_PORT"; then warn "port $WANT_PORT is in use by another program; keel2 start will use the next free port"; fi
      local sock; sock="$(docker_socket)"
      if [ "$(os)" = mac ] || [ -S "$sock" ]; then ok "Docker socket for --docker: $sock"; else warn "no Docker socket at $sock (only needed for --docker)"; fi
    else
      bad "Docker is installed but its engine is not running. Start Docker Desktop (or: sudo systemctl start docker)."; problems=$((problems + 1))
    fi
  fi
  command -v curl >/dev/null 2>&1 && ok "curl" || { bad "curl is missing (install it with your package manager)"; problems=$((problems + 1)); }
  command -v git >/dev/null 2>&1 && ok "git" || warn "git is missing on this computer (keel has its own; you need git to look at keel's commits)"
  if [ -n "${1:-}" ]; then
    local p; p="$(project_path "$1")"
    if [ -d "$p/.git" ] || ls -d "$p"/*/.git >/dev/null 2>&1; then ok "project: $p is a git repository"
      local dirty; dirty="$(git -C "$p" status --porcelain 2>/dev/null | grep -v '^?? .keel/' | wc -l | tr -d ' ')"
      [ "$dirty" = 0 ] || warn "project has $dirty uncommitted change(s); keel will ask (or its Doctor helps) before a flow starts"
    else bad "project: $p is not a git repository (keel2 start offers git init)"; problems=$((problems + 1)); fi
    check_shared "$p"
  fi
  if [ "$problems" = 0 ]; then info "${G}All good.${N}"; else info "${R}$problems problem(s) found.${N} Fix them and run keel2 doctor again."; return 1; fi
}

cmd_update() {
  need_docker
  # keel v2 does not use keel v1 any more: the old setting does nothing now
  [ -n "${KEEL_HOME:-}" ] && warn "KEEL_HOME is set but ignored since 0.4.1: keel v2 does not use keel v1 (see: keel2 help, --with-keel-v1)."
  # a keel started with --core gets the newest core image
  if container_exists && [ "$(label core)" = 1 ] && [ -z "${KEEL_IMAGE:-}" ]; then IMAGE="$CORE_IMAGE"; fi
  info "Getting the newest image ($IMAGE)…"
  docker pull "$IMAGE" || die "Could not download $IMAGE." "Check your internet connection."
  if container_exists && [ -n "$(label project)" ]; then KEEL_TAKE_NEW_IMAGE=1 cmd_restart; else ok "updated. Start keel with: keel2 start /path/to/project"; fi
}

# keel2 token <claude|codex|copilot|anthropic|openai|github> [value]
# Without a value it reads a pipe (pbpaste | keel2 token claude), or asks (hidden, not in shell history);
# `token codex` reads ~/.codex/auth.json when there is one. The value is checked before it is saved.
token_clean() {  # token_clean <which> <value>: without what a copy adds (spaces, line breaks, a terminal's paste marks)
  local v="$2" a=$'\e[200~' b=$'\e[201~'
  v="${v//"$a"/}"; v="${v//"$b"/}"
  if [ "$1" = codex ]; then printf '%s' "$v"; else printf '%s' "$v" | tr -d '[:space:]'; fi
}

token_problem() {  # token_problem <which> <value>: why it cannot be a token of that kind (one line), or nothing
  local which="$1" v="$2" bad seen="" c i
  if [ "$which" = codex ]; then
    case "$v" in \{*\}) ;; *) echo "a Codex login is the JSON file ~/.codex/auth.json (it starts with { and ends with })." ;; esac
    return 0
  fi
  case "$which" in
    claude|anthropic) bad="$(printf '%s' "$v" | LC_ALL=C tr -d 'A-Za-z0-9_-')" ;;
    *) bad="$(printf '%s' "$v" | LC_ALL=C tr -d 'A-Za-z0-9_.=-')" ;;
  esac
  if [ -n "$bad" ]; then
    for ((i = 0; i < ${#bad}; i++)); do c="${bad:i:1}"; case "$seen" in *"$c"*) ;; *) seen="$seen$c" ;; esac; done
    echo "it has characters a token never has (${seen:0:12})."
    return 0
  fi
  case "$which" in
    claude) case "$v" in sk-ant-*) ;; *) echo "a Claude login token starts with sk-ant- (this one has ${#v} characters)." ;; esac ;;
    anthropic) case "$v" in sk-ant-*) ;; *) echo "an Anthropic API key starts with sk-ant- (this one has ${#v} characters)." ;; esac ;;
  esac
}

cmd_token() {
  local which="${1:-}" value="${2:-}" name
  case "$which" in
    claude) name=CLAUDE_CODE_OAUTH_TOKEN ;; codex) name=CODEX_AUTH_JSON ;; copilot) name=GH_TOKEN ;;
    anthropic) name=ANTHROPIC_API_KEY ;; openai) name=OPENAI_API_KEY ;; github) name=GITHUB_TOKEN ;;
    *) die "usage: keel2 token <claude|codex|copilot|anthropic|openai|github> [value]" "Or from the clipboard: pbpaste | keel2 token claude" ;;
  esac
  need_docker
  container_running || die "keel is not running." "Start it first: keel2 start /path/to/project"
  # A pipe (pbpaste | keel2 token claude): the value comes in one piece, with no prompt.
  if [ -z "$value" ] && [ ! -t 0 ]; then value="$(cat)"; fi
  if [ -z "$value" ] && [ "$which" = codex ] && [ -f "$HOME/.codex/auth.json" ]; then value="$(cat "$HOME/.codex/auth.json")"; fi
  if [ -z "$value" ] && [ -t 0 ]; then
    [ "$which" = claude ] && info "Get it with: claude setup-token   (or use the dashboard: Connections › Set up login)"
    # A long token is often shown over two lines, so a paste holds line breaks: read every line of the paste.
    local line="" more
    IFS= read -rsp "Paste $name (input hidden), then press Enter: " line || true; echo
    value="$line"
    while IFS= read -rs -t 1 more; do value="$value$more"; done
  fi
  value="$(token_clean "$which" "$value")"
  # how to send the clipboard in one piece
  local mac="Copy the token and run: pbpaste | keel2 token $which"
  local linux="(Linux: wl-paste | keel2 token $which, or xclip -o -selection clipboard | keel2 token $which)"
  [ -n "$value" ] || die "Nothing arrived, so nothing was saved." "$mac" "$linux"
  local problem; problem="$(token_problem "$which" "$value")"
  if [ -n "$problem" ]; then
    case "$which" in
      codex) die "Not saved: $problem" "Run codex login, then: keel2 token codex (it reads ~/.codex/auth.json)." ;;
      *) die "Not saved: $problem" "A token shown over two lines is often copied with extra characters. Copy it in one piece." "$mac" "$linux" ;;
    esac
  fi
  # JSON is built inside keel's container (it has python3), so this computer needs no python.
  local body out code why
  body="$(printf '%s' "$value" | kpy -c 'import json,sys; print(json.dumps({"value": sys.stdin.read()}))')" \
    || die "Could not prepare $name for saving (keel's python did not answer)." "Is keel running? keel2 status"
  out="$(printf '%s' "$body" | kcurl -sS -w '\n%{http_code}' -X PUT "$(api)/secrets/$name" -H 'content-type: application/json' --data-binary @-)" \
    || die "Could not save $name: keel did not answer." "Is keel running? keel2 status"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  if [ "$code" != 200 ]; then
    why="$(printf '%s' "$out" | kpy -c '
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get("error") or ""); print(d.get("hint") or "")
except Exception:
    pass' 2>/dev/null || true)"
    die "Not saved: $(printf '%s\n' "$why" | sed -n 1p | grep . || echo "keel answered $code.")" \
      "$(printf '%s\n' "$why" | sed -n 2p | grep . || echo "Try the dashboard: Control › Connections.")"
  fi
  ok "saved $name in keel's database (encrypted) · $(printf '%s' "$out" | kpy -c 'import json,sys; print(json.load(sys.stdin).get("hint",""))' 2>/dev/null || true)"
}

cmd_tokens() {
  need_docker
  container_running || die "keel is not running." "Start it first: keel2 start /path/to/project"
  kcurl -fs "$(api)/connections" | kpy -c '
import json, sys
for p in json.load(sys.stdin)["providers"]:
    if p["id"] == "fake":
        continue
    login = (p.get("login_hint") or "saved") if p.get("login_set") else "not set"
    key = (p.get("key_hint") or "saved") if p.get("key_set") else "not set"
    print("%-14s login %-24s %-10s  api key: %s" % (p["label"], p.get("login_secret") or "-", login, key))'
}

cmd_backup() {
  need_docker
  resolve_volume
  local file="${1:-keel-backup-$(date +%Y%m%d-%H%M%S).tgz}"
  case "$file" in /*) ;; *) file="$PWD/$file" ;; esac
  docker volume inspect "$VOLUME" >/dev/null 2>&1 || die "There is no keel data yet (volume $VOLUME)."
  local was=0; container_running && was=1
  # The database is copied while keel is stopped, so the copy is consistent.
  [ "$was" = 1 ] && docker stop "$NAME" >/dev/null
  docker run --rm -v "$VOLUME:/data:ro" -v "$(dirname "$file"):/out" --entrypoint tar "$IMAGE" -czf "/out/$(basename "$file")" -C /data . \
    || { [ "$was" = 1 ] && docker start "$NAME" >/dev/null; die "Backup failed."; }
  [ "$was" = 1 ] && docker start "$NAME" >/dev/null
  ok "saved $file  ($(du -h "$file" | cut -f1)). It holds your encrypted logins and their key: keep it private."
}

cmd_restore() {
  local file="${1:-}"
  [ -f "$file" ] || die "usage: keel2 restore <backup.tgz>"
  need_docker
  resolve_volume
  volume_guard
  case "$file" in /*) ;; *) file="$PWD/$file" ;; esac
  ask_yes "Replace keel's current data (volume $VOLUME) with $file?" || die "Nothing changed."
  local was=0; container_running && was=1
  [ "$was" = 1 ] && docker stop "$NAME" >/dev/null
  docker run --rm -v "$VOLUME:/data" -v "$(dirname "$file"):/in:ro" --entrypoint sh "$IMAGE" -c \
    "find /data -mindepth 1 -delete && tar -xzf \"/in/$(basename "$file")\" -C /data" || die "Restore failed."
  [ "$was" = 1 ] && docker start "$NAME" >/dev/null
  ok "restored from $file"
}

remove_folders_file() { local f; f="$(folders_file)"; if [ -f "$f" ]; then rm -f "$f"; ok "removed the list of added folders ($f)"; fi; }

cmd_uninstall() {
  need_docker
  resolve_volume
  # never delete a data volume another running keel still uses
  if [ "${1:-}" = "--all" ]; then volume_guard; fi
  container_exists && docker rm -f "$NAME" >/dev/null && ok "removed the keel container"
  if [ "${1:-}" = "--all" ]; then
    if ! docker volume inspect "$VOLUME" >/dev/null 2>&1; then info "No keel data to remove."; remove_folders_file; return 0; fi
    warn "This deletes keel's data: logins, settings, flow history (volume $VOLUME). Your projects are not touched."
    ask_yes "Delete keel's data for good? (keel2 backup first if you may need it)" || { info "Kept keel's data."; return 0; }
    docker volume rm "$VOLUME" >/dev/null && ok "removed keel's data"
    remove_folders_file
  else
    info "  ${D}keel's data (volume $VOLUME) is kept. To remove it too: keel2 uninstall --all${N}"
  fi
}

# keel2 mcp [--write | --admin] [--allow t1,t2] [--yes] [--print-config]
# stdio passthrough to keel's MCP server (in the container, or the native engine's). Nothing but MCP may reach stdout here.
cmd_mcp() {
  local mode=--read-only print=0 extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --write) mode=--write ;;
      --admin) mode=--admin ;;
      --read-only) mode=--read-only ;;
      --yes) extra+=(--yes) ;;
      --allow) [ $# -ge 2 ] || die "--allow needs a list of tools" "For example: keel2 mcp --write --allow keel_status,keel_approve_gate"
               extra+=(--allow "$2"); shift ;;
      --allow=*) extra+=("$1") ;;
      --print-config) print=1 ;;
      *) die "Unknown option $1" "usage: keel2 mcp [--write | --admin] [--allow t1,t2] [--yes] [--print-config]" ;;
    esac
    shift
  done
  if [ "$print" = 1 ]; then print_mcp_config "$mode" ${extra[@]+"${extra[@]}"}; return 0; fi
  if native_mode && ! docker_keel_running; then
    native_running || die "keel is not running." "Start it first: keel2 start --native /path/to/project"
    local p; p="$(native_port)"
    KEEL_API_URL="http://127.0.0.1:$p" KEEL_INTERNAL_TOKEN="$(cat "$ND/run/token")" KEEL_PUBLIC_URL="${KEEL_PUBLIC_URL:-http://localhost:$p}" \
      KEEL_DATA="$ND/data" KEEL_PLUGINS_IMAGE="$ND/current/plugins" \
      exec "$ND/current/engine/.venv/bin/python" -m keel_engine.mcp "$mode" ${extra[@]+"${extra[@]}"}
  fi
  need_docker >&2
  container_running || die "keel is not running." "Start it first: keel2 start /path/to/project"
  # keel_dashboard's links: the dashboard as this computer sees it, not the container's own port
  local public="${KEEL_PUBLIC_URL:-}"; [ -n "$public" ] || public="http://localhost:$(running_port)"
  # v0.16.1 the internal token file (docker/keel-start writes it) lets the server ask the api for its level's token
  exec docker exec -i -e KEEL_PUBLIC_URL="$public" -e KEEL_INTERNAL_TOKEN_FILE=/data/run/internal-token "$NAME" \
    /opt/engine/.venv/bin/python -m keel_engine.mcp "$mode" ${extra[@]+"${extra[@]}"}
}

# keel2 plugins list | install <name>[@version] | remove <name> [--delete-data] | search [words] | update <name>
#              | rollback <name> | safe
# The plugin host's command line inside the container (keel-engine plugins, docs/plugins/13-step4-contract.md §5).
# What it installs or removes loads at the next start: keel2 restart.
cmd_plugins() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  local engine=(docker exec "$NAME" /opt/engine/.venv/bin/keel-engine plugins)
  case "$sub" in
    safe) cmd_restart --safe "$@"; return ;;
    list|install|remove|search|update|rollback) ;;
    *) die "Unknown plugins command: $sub" "usage: keel2 plugins list | install <name> | remove <name> | search [words] | update <name> | rollback <name> | safe" ;;
  esac
  need_docker
  container_running || die "keel is not running." "Start it first: keel2 start /path/to/project"
  case "$sub" in
    list)     "${engine[@]}" list "$@" ;;
    search)   "${engine[@]}" search "$@" ;;
    install)  [ $# -ge 1 ] || die "usage: keel2 plugins install <name>[@version]"; "${engine[@]}" get "$@" ;;
    remove)   [ $# -ge 1 ] || die "usage: keel2 plugins remove <name> [--delete-data]"; "${engine[@]}" remove "$@" ;;
    update)   [ $# -ge 1 ] || die "usage: keel2 plugins update <name>"; "${engine[@]}" update "$@" ;;
    rollback) [ $# -ge 1 ] || die "usage: keel2 plugins rollback <name>"; "${engine[@]}" rollback "$@" ;;
  esac
}

print_mcp_config() {  # print_mcp_config <--read-only|--write|--admin> [extra args…]
  local level="$1"; shift
  local self; self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  local env_cli="" env_json="" jself
  if [ "$NAME" != keel-v2 ]; then env_cli=" -e KEEL_NAME=$NAME"; env_json=", \"env\": { \"KEEL_NAME\": \"$NAME\" }"; fi
  jself="$(printf '%s' "$self" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  local more="" jmore="" a
  for a in "$@"; do more="$more $a"; jmore="$jmore, \"$(printf '%s' "$a" | sed 's/"/\\"/g')\""; done
  local lv name args jargs
  for lv in --read-only --write --admin; do
    [ "$level" = --read-only ] || [ "$lv" = "$level" ] || continue
    case "$lv" in
      --read-only) name=keel-v2; args=""; jargs='"mcp"'; info "${B}read${N} (default): look at flows, Inbox, live agents, budget, specs, knowledge, code; change nothing" ;;
      --write) name=keel-v2; args=" --write"; jargs='"mcp", "--write"'; info "${B}write${N}: also decide gates, answer the Inbox, start flows, restore a spec, git / PR / CI / DB writes" ;;
      --admin) name=keel-v2; args=" --admin"; jargs='"mcp", "--admin"'; info "${B}admin${N}: also stop and delete flows, add and remove projects, change workflows" ;;
    esac
    info "  Claude Code:    claude mcp add $name$env_cli -- $self mcp$args$more"
    info "  Claude Desktop: \"mcpServers\": { \"$name\": { \"command\": \"$jself\", \"args\": [$jargs$jmore]$env_json } }"
    info ""
  done
  info "${D}Push, DB changes, deletes and stops ask you first in the client; a client that cannot ask is refused unless --yes.${N}"
  info "${D}--allow keel_status,keel_approve_gate keeps only those tools. keel's own agents always get it read-only.${N}"
}

# ---------------------------------------------------------------- native mode (keel2 start --native, v0.16.1)
# keel on this computer without Docker: ~/.keel2/<KEEL_NAME>/ holds app/<version> (api.jar, engine/.venv, content),
# current -> app/<version>, data/ (KEEL_DATA), npm/ (keel's own agent CLIs and codegraph), run/ (pid, ports, token)
# and logs/. A native keel answers the same commands; when it exists, the Docker helpers below are replaced.
ND="${KEEL2_HOME:-$HOME/.keel2}/$NAME"
RELEASE_URL="${KEEL_RELEASE_URL:-https://github.com/MiladNalbandi/keel-v2/releases/download}"
native_mode() { [ -f "$ND/mode" ] && [ "$(cat "$ND/mode" 2>/dev/null)" = native ]; }
native_pid() { cat "$ND/run/keel.pid" 2>/dev/null || true; }
native_running() {  # the pid file's process is alive and is keel's own start script (not a pid reused after a reboot)
  local p; p="$(native_pid)"
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && ps -p "$p" -o command= 2>/dev/null | grep -q "keel-native-start"
}
native_port() { sed -n 's/^api=//p' "$ND/run/ports" 2>/dev/null || true; }
version_newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }   # $1 newer than $2
sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
docker_keel_running() { command -v docker >/dev/null 2>&1 && [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || echo false)" = true ]; }

native_hint() {
  case "$(os)" in
    mac) case "$1" in java) echo "brew install openjdk@21" ;; node) echo "brew install node" ;; *) echo "brew install $1" ;; esac ;;
    linux) case "$1" in java) echo "sudo apt install openjdk-21-jre (or your distribution's Java 21)" ;; uv) echo "curl -LsSf https://astral.sh/uv/install.sh | sh" ;; *) echo "install $1 with your package manager" ;; esac ;;
    *) echo "install $1" ;;
  esac
}

native_need() {  # what native mode needs on this computer: Java 21, uv, git, curl (Node only for the agent CLIs)
  local v; v="$(java -version 2>&1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -1)"
  { [ -n "$v" ] && [ "$v" -ge 21 ]; } 2>/dev/null || die "Native mode needs Java 21 or newer (java -version)." "Install it: $(native_hint java)"
  command -v uv >/dev/null 2>&1 || die "Native mode needs uv (it installs keel's Python packages)." "Install it: $(native_hint uv)"
  command -v git >/dev/null 2>&1 || die "Native mode needs git." "Install it: $(native_hint git)"
  command -v curl >/dev/null 2>&1 || die "Native mode needs curl." "Install it: $(native_hint curl)"
}

native_warn() {  # once per keel: agents run as you
  [ -f "$ND/.warned" ] && return 0
  warn "Native mode: keel's agents run as you, with your files, your SSH keys and your network."
  warn "In Docker they only see the project folders. Docker stays the default: use native mode only on a computer and projects you trust."
  if [ "${KEEL_YES:-0}" = 1 ] || ask_yes "Start keel natively?"; then mkdir -p "$ND"; : > "$ND/.warned"; return 0; fi
  die "Not started (native mode needs your yes; KEEL_YES=1 gives it without asking)." "Or use Docker: keel2 start [folder]"
}

native_install() {  # native_install [tarball] [version] — a release (default $KEEL2_VERSION) or the given tarball into app/<version>
  local tgz="${1:-}" want="${2:-$KEEL2_VERSION}" tmp dir v name
  (umask 077; mkdir -p "$ND")
  tmp="$(mktemp -d)"
  if [ -z "$tgz" ]; then
    v="$want"; name="keel-v2-$v-native.tar.gz"
    info "Getting keel v2 $v for native mode…"
    curl -fsSL "$RELEASE_URL/v$v/$name" -o "$tmp/$name" && curl -fsSL "$RELEASE_URL/v$v/$name.sha256" -o "$tmp/$name.sha256" \
      || die "Could not download keel v2 $v ($RELEASE_URL/v$v/$name)." "Check your internet connection, or build it: keel2 start --native --from-source <keel-v2 checkout>"
    [ "$(sha256_of "$tmp/$name")" = "$(cut -d' ' -f1 "$tmp/$name.sha256")" ] || die "The download's checksum does not match, so keel does not use it." "Try again later."
    tgz="$tmp/$name"
  fi
  tar -xzf "$tgz" -C "$tmp" || die "Could not unpack $tgz."
  dir="$(ls -d "$tmp"/keel-v2-*/ 2>/dev/null | head -1)"; dir="${dir%/}"
  [ -n "$dir" ] && [ -f "$dir/VERSION" ] && [ -f "$dir/api.jar" ] || die "$tgz is not a keel v2 native release."
  v="$(cat "$dir/VERSION")"
  mkdir -p "$ND/app"
  [ -d "$ND/app/$v" ] && mv "$ND/app/$v" "$tmp/old-$v"
  mv "$dir" "$ND/app/$v"
  info "Installing keel's engine (uv sync)…"
  (cd "$ND/app/$v/engine" && UV_PROJECT_ENVIRONMENT="$ND/app/$v/engine/.venv" uv sync --frozen --no-dev -q) || die "uv could not install the engine." "Run it again, or see: keel2 doctor"
  if [ -e "$ND/current" ] && [ "$(readlink "$ND/current")" != "$ND/app/$v" ]; then ln -sfn "$(readlink "$ND/current")" "$ND/previous"; fi
  rm -rf -- "$tmp"
  ln -sfn "$ND/app/$v" "$ND/current"
  ok "keel v2 $v installed ($ND/app/$v)"
}

native_clis() {  # keel's own agent CLIs and codegraph, pinned like the image, with npm --prefix (no sudo)
  [ "${KEEL_NATIVE_CLIS:-1}" = 1 ] || return 0
  [ -x "$ND/npm/bin/codegraph" ] && return 0
  command -v npm >/dev/null 2>&1 || { warn "npm is missing, so keel's agent CLIs are not installed. Node 20+: $(native_hint node)"; return 0; }
  info "Installing the agent CLIs and codegraph into $ND/npm (once)…"
  npm i -g --prefix "$ND/npm" --no-audit --no-fund @anthropic-ai/claude-code @openai/codex @github/copilot opencode-ai \
    "@colbymchenry/codegraph@1.6.2" >/dev/null 2>&1 || warn "npm could not install every agent CLI; see: keel2 doctor"
}

native_free() {  # native_free <from> [taken] — the first free port from <from>
  local p="$1" i; for i in $(seq 0 20); do
    if [ "$p" != "${2:-}" ] && ! port_busy "$p"; then echo "$p"; return 0; fi
    p=$((p + 1))
  done
  die "No free port between $1 and $p." "Free one, or choose another: PORT=9090 keel2 start --native"
}

native_start() {  # native_start <project> <tarball or ""> <source checkout or "">
  local project="$1" tgz="$2" src="$3"
  native_need
  docker_keel_running && die "A Docker keel called $NAME runs already." "Stop it first (keel2 stop), or use another KEEL_NAME."
  native_warn
  if native_running; then guard_busy restart; native_stop_quiet; fi
  if [ -n "$src" ]; then
    local out; out="$(mktemp -d)"
    info "Building keel v2 from $src…"
    tgz="$("$src/scripts/build-native.sh" "$out" | tail -1)" || die "The build failed." "Run $src/scripts/build-native.sh to see why."
  fi
  # install when there is none, when a tarball is given, or when this script is newer than the installed one
  # (never back down: keel2 update may have installed a newer release than this script knows)
  local have; have="$(cat "$ND/current/VERSION" 2>/dev/null || true)"
  if [ -n "$tgz" ] || [ ! -f "$ND/current/api.jar" ] || version_newer "$KEEL2_VERSION" "$have"; then native_install "$tgz"; fi
  native_clis
  # keel's data (its database, logins, agent homes) and logs are this person's only
  (umask 077; mkdir -p "$ND/run" "$ND/logs" "$ND/data")
  chmod 700 "$ND" "$ND/run" "$ND/logs" "$ND/data" 2>/dev/null || true
  local port eport folders f tok
  port="$(native_free "$WANT_PORT")"; eport="$(native_free 8090 "$port")"
  folders="$project"
  while IFS= read -r f; do
    [ "$f" = "$project" ] && continue
    case "$f" in "$project"/*) continue ;; esac
    if [ -d "$f" ]; then folders="$folders:$f"; else warn "The added folder $f is missing, so keel skips it."; fi
  done < <(list_folders)
  [ -f "$ND/logs/keel.log" ] && mv "$ND/logs/keel.log" "$ND/logs/keel.log.1"
  echo native > "$ND/mode"
  printf '%s\n' "$project" > "$ND/project"
  printf 'api=%s\nengine=%s\n' "$port" "$eport" > "$ND/run/ports"
  tok="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  (umask 077; printf '%s' "$tok" > "$ND/run/token")
  info "Starting keel natively for ${B}$project${N}…"
  KEEL_APP="$ND/current" KEEL_DATA="$ND/data" KEEL_WORKSPACE="$project" KEEL_PROJECT_NAME="$(basename "$project")" \
    KEEL_FOLDERS="$folders" KEEL_PORT="$port" KEEL_ENGINE_PORT="$eport" KEEL_NPM="$ND/npm" KEEL_INTERNAL_TOKEN="$tok" \
    KEEL_PLUGINS="${NATIVE_PLUGINS:-${KEEL_PLUGINS:-on}}" \
    nohup "$ND/current/keel-native-start" >> "$ND/logs/keel.log" 2>&1 < /dev/null &
  echo $! > "$ND/run/keel.pid"
  local i; for i in $(seq 1 180); do
    curl -fs "$(api "$port")/health" >/dev/null 2>&1 && break
    native_running || { bad "keel did not start. The last lines of its log:"; tail -25 "$ND/logs/keel.log" | sed 's/^/    /'; die "Start failed." "See: keel2 logs, keel2 doctor"; }
    sleep 1
  done
  curl -fs "$(api "$port")/health" >/dev/null 2>&1 || die "keel did not answer in 3 minutes." "See: keel2 logs"
  ok "keel is running natively: ${B}http://localhost:$port${N}"
  local added=(); while IFS= read -r f; do [ "$f" != "$project" ] && [ -d "$f" ] && added+=("$f"); done < <(list_folders)
  register_added "$port" ${added[@]+"${added[@]}"}
  info "  ${D}Stop: keel2 stop · Status: keel2 status · Logs: keel2 logs${N}"
  [ "${KEEL_OPEN:-1}" = 1 ] && open_signed_in "$port" || true
}

native_stop_quiet() {
  local p; p="$(native_pid)"
  [ -n "$p" ] || return 0
  kill -TERM "$p" 2>/dev/null || true
  local i; for i in $(seq 1 20); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
  if kill -0 "$p" 2>/dev/null; then pkill -KILL -P "$p" 2>/dev/null || true; kill -KILL "$p" 2>/dev/null || true; fi
  rm -f "$ND/run/keel.pid"
}

native_status() {
  if ! native_running; then info "keel (native) is ${B}not running${N}. Start it: keel2 start --native /path/to/project"; return 0; fi
  local port body version=""; port="$(native_port)"
  body="$(curl -fs "$(api "$port")/health" 2>/dev/null || true)"
  version="$(printf '%s' "$body" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
  info "keel is ${B}running natively${N} ($([ -n "$body" ] && echo ready || echo starting))"
  info "  dashboard  http://localhost:$port"
  [ -n "$version" ] && info "  version    keel v2 $version"
  info "  project    $(cat "$ND/project" 2>/dev/null)"
  local f; while IFS= read -r f; do info "  added      $f$([ -d "$f" ] || echo "  (missing)")"; done < <(list_folders)
  info "  files      $ND"
  warn "agents run as you (native mode): they can read what you can."
}

native_doctor() {
  local problems=0 v
  info "${B}keel2 doctor${N} (native mode)"
  v="$(java -version 2>&1 | sed -n 's/.*version "\([0-9][0-9]*\).*/\1/p' | head -1)"
  if [ -n "$v" ] && [ "$v" -ge 21 ] 2>/dev/null; then ok "Java $v"; else bad "Java 21 is missing: $(native_hint java)"; problems=$((problems + 1)); fi
  if command -v uv >/dev/null 2>&1; then ok "$(uv --version)"; else bad "uv is missing: $(native_hint uv)"; problems=$((problems + 1)); fi
  command -v git >/dev/null 2>&1 && ok "git" || { bad "git is missing"; problems=$((problems + 1)); }
  command -v node >/dev/null 2>&1 && ok "node $(node --version)" || warn "node is missing: keel's agent CLIs need Node 20+ ($(native_hint node))"
  command -v sqlite3 >/dev/null 2>&1 && ok "sqlite3" || warn "sqlite3 is missing: only keel2 sql needs it ($(native_hint sqlite3))"
  [ -f "$ND/current/api.jar" ] && ok "keel v2 $(cat "$ND/current/VERSION") in $ND/current" || warn "keel is not installed yet (keel2 start --native installs it)"
  [ -x "$ND/npm/bin/codegraph" ] && ok "agent CLIs and codegraph in $ND/npm" || warn "agent CLIs not installed yet (keel2 start --native installs them)"
  mkdir -p "$ND" 2>/dev/null && [ -w "$ND" ] && ok "$ND is writable" || { bad "$ND is not writable"; problems=$((problems + 1)); }
  local p; p="$(native_port)"; if native_running; then ok "keel runs on port $p"; elif [ -n "$p" ] && port_busy "$p"; then warn "port $p is used by something else"; fi
  [ "$problems" = 0 ] && ok "no problems found" || die "$problems problem(s) found."
}

native_update() {
  [ "${1:-}" = --rollback ] && {
    [ -L "$ND/previous" ] || die "There is no earlier version to go back to."
    local cur; cur="$(readlink "$ND/current")"; ln -sfn "$(readlink "$ND/previous")" "$ND/current"; ln -sfn "$cur" "$ND/previous"
    ok "back to keel v2 $(cat "$ND/current/VERSION")"
    native_running && { native_stop_quiet; native_start "$(cat "$ND/project")" "" ""; }
    return 0
  }
  # the newest release, not only the one this keel2 script knows
  local latest have was=0
  latest="$(curl -fsSL "${KEEL_RELEASES_API:-https://api.github.com/repos/MiladNalbandi/keel-v2/releases/latest}" 2>/dev/null \
    | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$latest" ] || latest="$KEEL2_VERSION"
  have="$(cat "$ND/current/VERSION" 2>/dev/null || true)"
  if [ "$latest" = "$have" ]; then ok "keel v2 $have is the newest release already."; return 0; fi
  # stop first: the running api and engine are never replaced under them
  if native_running; then guard_busy update; native_stop_quiet; was=1; fi
  native_install "" "$latest"
  [ "$was" = 1 ] && native_start "$(cat "$ND/project")" "" ""
  [ "$latest" = "$KEEL2_VERSION" ] || info "  ${D}This keel2 script is $KEEL2_VERSION; get the newest one too: curl -fsSL …/install.sh | sh${N}"
  return 0
}

native_backup() {
  local file="${1:-keel2-backup-$(date +%Y%m%d-%H%M%S).tgz}"
  case "$file" in /*) ;; *) file="$PWD/$file" ;; esac
  native_running && warn "keel is running: the backup is taken while it works (stop it first for a quiet copy)."
  tar -C "$ND/data" -czf "$file" . && ok "saved keel's data to $file"
}

native_restore() {
  local file="${1:-}"; [ -f "$file" ] || die "usage: keel2 restore <backup.tgz>"
  ask_yes "Replace keel's data in $ND/data with $file?" || [ "${KEEL_YES:-0}" = 1 ] || die "Nothing changed."
  local was=0; native_running && { was=1; native_stop_quiet; }
  mkdir -p "$ND/data" && find "$ND/data" -mindepth 1 -maxdepth 1 -exec rm -rf {} + && tar -C "$ND/data" -xzf "$file" && ok "restored from $file"
  [ "$was" = 1 ] && native_start "$(cat "$ND/project")" "" ""
  return 0
}

native_uninstall() {
  native_running && native_stop_quiet
  if [ "${1:-}" = --all ]; then
    ask_yes "Remove $ND (keel's data, logins and history)?" || [ "${KEEL_YES:-0}" = 1 ] || die "Nothing removed."
    # only a folder keel made for this name: <KEEL2_HOME>/<KEEL_NAME> with keel's own marker files in it
    case "$NAME" in ""|.|..|*/*) die "Refusing to remove $ND (KEEL_NAME is \"$NAME\")." ;; esac
    { [ -f "$ND/project" ] || [ -f "$ND/.warned" ]; } && [ -d "$ND/app" ] || die "Refusing to remove $ND: it does not look like a native keel's folder."
    find "$ND" -mindepth 1 -delete 2>/dev/null; rmdir "$ND" 2>/dev/null; ok "removed $ND"
    remove_folders_file
  else
    rm -f "$ND/mode"; ok "keel (native) stopped; its data stays in $ND/data (keel2 uninstall --all removes it)"
  fi
}

kpy() {  # a python for the JSON helpers: the container's, or the native engine's
  if native_mode; then "$ND/current/engine/.venv/bin/python" "$@"; else docker exec -i "$NAME" python3 "$@"; fi
}

if native_mode && ! docker_keel_running; then
  need_docker() { :; }
  container_exists() { [ -f "$ND/project" ] && native_running; }
  container_running() { native_running; }
  running_port() { native_port; }
  label() { case "$1" in project) cat "$ND/project" 2>/dev/null || true ;; docker) echo 0 ;; *) echo "" ;; esac; }
  keel_running() { native_running; }
  cmd_stop() {
    native_running || { info "keel is not running."; return 0; }
    [ "${1:-}" = "--force" ] && KEEL_FORCE=1
    guard_busy stop
    native_stop_quiet && ok "keel stopped (your data and logins are kept in $ND/data)"
  }
  cmd_restart() {  # keel2 restart [--safe] [--force]
    local a; NATIVE_PLUGINS=""
    for a in "$@"; do
      case "$a" in
        --force) KEEL_FORCE=1 ;;
        --safe) NATIVE_PLUGINS=image ;;
        *) die "Unknown option $a" "usage: keel2 restart [--safe] [--force]" ;;
      esac
    done
    native_start "$(cat "$ND/project")" "" ""
  }
  cmd_plugins() {  # the plugin host's command line with the release's engine (the same commands as in Docker)
    local sub="${1:-list}"; [ $# -gt 0 ] && shift
    case "$sub" in
      safe) cmd_restart --safe "$@"; return ;;
      list|search) ;;
      install|remove|update|rollback) [ $# -ge 1 ] || die "usage: keel2 plugins $sub <name>" ;;
      *) die "Unknown plugins command: $sub" "usage: keel2 plugins list | install <name> | remove <name> | search [words] | update <name> | rollback <name> | safe" ;;
    esac
    [ "$sub" = install ] && sub=get
    KEEL_DATA="$ND/data" KEEL_PLUGINS_IMAGE="$ND/current/plugins" KEEL_CONTENT="$ND/current/content" \
      "$ND/current/engine/.venv/bin/keel-engine" plugins "$sub" "$@"
  }
  cmd_status() { native_status; }
  cmd_doctor() { native_doctor; }
  cmd_update() { native_update "$@"; }
  cmd_backup() { native_backup "$@"; }
  cmd_restore() { native_restore "$@"; }
  cmd_uninstall() { native_uninstall "$@"; }
fi

cmd_help() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

# keel2 tui [keel-tui options]: keel's terminal app (cli/, docs/plans/keel-tui.md) for the running keel. With Docker it
# runs inside keel's container (Node is there, nothing to install); natively, the release's cli/keel-tui.mjs with this
# computer's Node. The folder you are in picks the project. KEEL_TUI_JS=<keel-tui.mjs> runs that file with this
# computer's Node instead (a checkout's cli/dist/keel-tui.mjs).
cmd_tui() {
  local port public
  if native_mode && ! docker_keel_running; then
    native_running || die "keel is not running." "Start it first: keel2 start --native /path/to/project"
    port="$(native_port)"; public="${KEEL_PUBLIC_URL:-http://localhost:$port}"
    local js="${KEEL_TUI_JS:-$ND/current/cli/keel-tui.mjs}"
    [ -f "$js" ] || die "This keel has no terminal app (keel TUI) yet." "Get a newer release: keel2 update"
    command -v node >/dev/null 2>&1 || die "keel TUI needs Node 20 or newer on this computer." "Install it: $(native_hint node)"
    KEEL_WEB_KEY_FILE="$ND/data/run/web-key" exec node "$js" --url "http://127.0.0.1:$port" --public-url "$public" "$@"
  fi
  need_docker
  container_running || die "keel is not running." "Start it first: keel2 start /path/to/project"
  port="$(running_port)"; public="${KEEL_PUBLIC_URL:-http://localhost:$port}"
  if [ -n "${KEEL_TUI_JS:-}" ]; then
    command -v node >/dev/null 2>&1 || die "KEEL_TUI_JS needs Node 20 or newer on this computer."
    # v0.18.1 the sign-in key from keel's container (an env value: never on a command line)
    KEEL_WEB_KEY="$(docker exec "$NAME" cat /data/run/web-key 2>/dev/null || true)" \
      exec node "$KEEL_TUI_JS" --url "http://127.0.0.1:$port" --public-url "$public" "$@"
  fi
  # this folder as keel's container sees it (the project is at /workspace; with --docker and added folders, at the same path)
  local project here="" f
  project="$(label project)"
  if [ "$(label docker)" = 1 ]; then here="$PWD"
  else case "$PWD/" in "$project"/*) here="/workspace${PWD#"$project"}" ;; esac; fi
  if [ -z "$here" ]; then
    while IFS= read -r f; do case "$PWD/" in "$f"/*) here="$PWD" ;; esac; done < <(container_folders)
  fi
  docker exec "$NAME" test -f /opt/keel-v2/cli/keel-tui.mjs 2>/dev/null \
    || die "This keel's image has no terminal app (keel TUI) yet." "Get a newer image: keel2 update"
  local tty=(-i); if interactive; then tty=(-it); fi
  # --profile: the record is written in the container, then copied here (it stays on this computer)
  local a profile=0; for a in "$@"; do [ "$a" = --profile ] && profile=1; done
  if [ "$profile" = 1 ]; then
    local out="${XDG_STATE_HOME:-$HOME/.local/state}/keel2/tui-profiles" rc=0
    docker exec "$NAME" rm -rf /tmp/keel-tui-profiles >/dev/null 2>&1 || true
    DOCKER_CLI_HINTS=false docker exec "${tty[@]}" -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" -e KEEL_PUBLIC_URL="$public" \
      -e NO_COLOR -e FORCE_COLOR -e KEEL_TUI_THEME -e KEEL_TUI_ASCII -e COLORFGBG -e KEEL_TUI_PROFILE_DIR=/tmp/keel-tui-profiles \
      -e KEEL_TUI_CWD="$here" -e KEEL_WEB_KEY_FILE=/data/run/web-key "$NAME" node /opt/keel-v2/cli/keel-tui.mjs --url http://127.0.0.1:8080 "$@" || rc=$?
    mkdir -p "$out" && docker cp "$NAME:/tmp/keel-tui-profiles/." "$out/" >/dev/null 2>&1 \
      && info "  ${D}The profile is on this computer now: $out/$(ls -t "$out" | head -1)${N}"
    return "$rc"
  fi
  # keel's colours follow this terminal: NO_COLOR, FORCE_COLOR, KEEL_TUI_THEME, KEEL_TUI_ASCII and COLORFGBG go in when set
  DOCKER_CLI_HINTS=false exec docker exec "${tty[@]}" -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" -e KEEL_PUBLIC_URL="$public" \
    -e NO_COLOR -e FORCE_COLOR -e KEEL_TUI_THEME -e KEEL_TUI_ASCII -e COLORFGBG \
    -e KEEL_TUI_CWD="$here" -e KEEL_WEB_KEY_FILE=/data/run/web-key "$NAME" node /opt/keel-v2/cli/keel-tui.mjs --url http://127.0.0.1:8080 "$@"
}

# ---------------------------------------------------------------- main
cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start)            # a stopped native keel, started with Docker now: forget native mode, then load the Docker helpers again
                    case " $* " in *" --native "*|*" --from-tarball "*|*" --from-source "*) ;;
                      *) if native_mode && ! native_running; then rm -f "$ND/mode"; exec "$0" start "$@"; fi ;; esac
                    cmd_start "$@" ;;
  --docker)         cmd_start --docker "$@" ;;          # keel2 --docker <folder>   (older form)
  stop)             cmd_stop "$@" ;;
  restart)          cmd_restart "$@" ;;
  status|ps)        cmd_status ;;
  add)              cmd_add "$@" ;;
  remove|rm)        cmd_remove "$@" ;;
  folders)          cmd_folders ;;
  open)             cmd_open "$@" ;;
  auth)             cmd_auth "$@" ;;
  logs)             if native_mode && ! docker_keel_running; then [ -f "$ND/logs/keel.log" ] || die "keel has no log yet."; exec tail -n 100 -F "$ND/logs/keel.log"; fi
                    need_docker; container_exists || die "keel is not running."; exec docker logs -f --tail 100 "$NAME" ;;
  doctor|check)     cmd_doctor "$@" ;;
  update|upgrade)   cmd_update "$@" ;;
  token)            cmd_token "$@" ;;
  tokens)           cmd_tokens ;;
  backup)           cmd_backup "$@" ;;
  restore)          cmd_restore "$@" ;;
  mcp)              cmd_mcp "$@" ;;
  plugins)          cmd_plugins "$@" ;;
  sql)              if native_mode && ! docker_keel_running; then
                      command -v sqlite3 >/dev/null 2>&1 || die "keel2 sql needs sqlite3 on this computer." "Install it: $(native_hint sqlite3)"
                      exec sqlite3 -header -column "$ND/data/keel.db"; fi
                    need_docker; container_running || die "keel is not running."; exec docker exec -it "$NAME" sqlite3 -header -column /data/keel.db ;;
  uninstall)        cmd_uninstall "$@" ;;
  version|-v|--version) if native_mode; then echo "keel2 $KEEL2_VERSION · native ($ND)"; else echo "keel2 $KEEL2_VERSION · image $IMAGE"; fi ;;
  tui)              cmd_tui "$@" ;;
  "")               # in a terminal, with keel running: keel TUI; otherwise the help, as before
                    if interactive && [ "${KEEL_TUI_DEFAULT:-1}" != 0 ] && keel_running; then cmd_tui; else cmd_help; fi ;;
  help|-h|--help)   cmd_help ;;
  *)
    if [ -d "$cmd" ]; then cmd_start "$cmd" "$@"          # keel2 <folder>   (older form)
    else die "Unknown command: $cmd" "See: keel2 help"; fi ;;
esac
